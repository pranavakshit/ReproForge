@startuml
title ReproForge: Cross-Environment Software Build Reproducibility and Diagnostic Framework

skinparam backgroundColor #FAFAFA
skinparam componentStyle uml2
skinparam packageStyle rectangle

package "Presentation Layer" as PresentationPkg {
  [Native Rust Desktop UI (Slint / Iced)] as DesktopApp
  [ReproForge CLI Application] as CliApp
  [Optional Headless API (FastAPI / Automation)] as HeadlessApi
}

package "Shared Application Service Layer" as ServicesPkg {
  [Repository Service] as RepoService
  [Fingerprint Service] as FpService
  [Build Execution Service] as BuildService
  [Artifact Comparison Service] as CompService
  [Diagnostic & Remediation Service] as DiagService
}

package "Execution & Orchestration Layer" as ExecutionPkg {
  [Git Repository Manager] as GitManager
  [Build Configuration Detector] as Detector
  [Workspace & Sandbox Manager] as WorkspaceMgr
  [Local Sandbox & Docker Runner] as RunnerBackend
  [Artifact Discovery & Hasher Collector] as Collector
}

package "Differential & Diagnostic Engine" as AnalysisPkg {
  [Dual-Mode Normalizer (Strict vs Normalized)] as Normalizer
  [Structural Differential Diff Engine] as DiffEngine
  [Rule-Based Diagnostic Engine (11 Rules)] as DiagRules
  [Remediation Generator (3-Tier Guidance)] as RemediationGen
  [Reproducibility Assessment & CRI Scorer] as Scorer
}

package "Durable Persistence Layer" as PersistencePkg {
  [Async Repositories & Crash Reconciler] as Repositories
  database "SQLite WAL Database (aiosqlite Engine)" as SqliteDb
}

' Distinct unique arrow colors for every individual connection
DesktopApp -[#1E88E5]-> ServicesPkg : 1. Local Structured IPC Calls
CliApp -[#D81B60]-> ServicesPkg : 2. Direct Python Async Invocations
HeadlessApi -[#8E24AA]-> ServicesPkg : 3. Remote Ingestion Endpoints
RepoService -[#3949AB]-> GitManager : 4. Pinned Commit Resolution & Clean Export
FpService -[#00ACC1]-> Repositories : 5. Telemetry Capture & Canonical Fingerprints
BuildService -[#00897B]-> Detector : 6. Auto-detects Build Systems & Lockfiles
BuildService -[#43A047]-> WorkspaceMgr : 7. Allocates Isolated Build Workspaces
BuildService -[#7CB342]-> RunnerBackend : 8. Executes Sandboxed Subprocesses
RunnerBackend -[#C0CA33]-> Collector : 9. Discovers & Stream-hashes Build Artifacts
Collector -[#FDD835]-> Repositories : 10. Persists Strict SHA-256 Digest Records
CompService -[#FFB300]-> Normalizer : 11. Normalizes Timestamps, Perms & Gzip Headers
CompService -[#FB8C00]-> DiffEngine : 12. Executes Recursive Archive & File Diffs
DiffEngine -[#F4511E]-> DiagRules : 13. Feeds Structural Findings & Content Diffs
DiagRules -[#6D4C41]-> RemediationGen : 14. Generates Recommendation-only Guidance
DiagRules -[#546E7A]-> Scorer : 15. Provides Classified Failure Evidence
Scorer -[#E53935]-> CompService : 16. Produces Metric Vector & Categorical Verdict
CompService -[#880E4F]-> Repositories : 17. Persists Comparisons, Findings & Verdicts
BuildService -[#4A148C]-> Repositories : 18. Tracks Build Lifecycle & Post-Crash Recovery
Repositories -[#0D47A1]-> SqliteDb : 19. Atomic WAL Commits with Busy Timeout
@enduml
