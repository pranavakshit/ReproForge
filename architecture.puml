@startuml
title ReproForge: Cross-Environment Software Build Reproducibility and Diagnostic Framework

skinparam backgroundColor #FAFAFA
skinparam componentStyle uml2
skinparam packageStyle rectangle

package "Presentation & Client Layer" as PresentationPkg {
  [Native Rust Desktop UI (Slint v1.19.0)] as DesktopApp
  [Rust Child Process Supervisor & Client] as RustSupervisor
  [ReproForge CLI Application] as CliApp
  [Optional Headless API (FastAPI / Automation)] as HeadlessApi
}

package "Engine Daemon & Dispatcher Layer" as DaemonPkg {
  [Python Background Engine Daemon (JSON-RPC 2.0 Stdio)] as EngineDaemon
}

package "Shared Application Service Layer" as ServicesPkg {
  [Repository Service] as RepoService
  [Fingerprint Service] as FpService
  [Build Execution Service] as BuildService
  [Artifact Comparison Service] as CompService
  [Diagnostic & Remediation Service] as DiagService
}

package "Execution & Orchestration Layer" as ExecutionPkg {
  [Git Repository Manager] as GitManager
  [Build Configuration Detector] as Detector
  [Workspace & Sandbox Manager] as WorkspaceMgr
  [Local Sandbox & Docker Runner] as RunnerBackend
  [Artifact Discovery & Hasher Collector] as Collector
}

package "Differential & Diagnostic Engine" as AnalysisPkg {
  [Dual-Mode Normalizer (Strict vs Normalized)] as Normalizer
  [Structural Differential Diff Engine] as DiffEngine
  [Rule-Based Diagnostic Engine (11 Rules)] as DiagRules
  [Remediation Generator (3-Tier Guidance)] as RemediationGen
  [Reproducibility Assessment & CRI Scorer] as Scorer
}

package "Durable Persistence Layer" as PersistencePkg {
  [Async Repositories & Crash Reconciler] as Repositories
  database "SQLite WAL Database (aiosqlite Engine)" as SqliteDb
}

' Distinct unique arrow colors for every individual connection
DesktopApp -[#1E88E5]-> RustSupervisor : 1. Thread-safe UI State & Event Dispatch
RustSupervisor -[#00897B]-> EngineDaemon : 2. Isolated Stdio JSON-RPC 2.0 with Heartbeat & Auto-Restart
EngineDaemon -[#D81B60]-> ServicesPkg : 3. Dispatches Asynchronous Requests to Services
CliApp -[#8E24AA]-> ServicesPkg : 4. Direct Python Async Invocations
HeadlessApi -[#3949AB]-> ServicesPkg : 5. Remote Ingestion Endpoints
RepoService -[#00ACC1]-> GitManager : 6. Pinned Commit Resolution & Clean Export
FpService -[#2E7D32]-> Repositories : 7. Telemetry Capture & Canonical Fingerprints
BuildService -[#43A047]-> Detector : 8. Auto-detects Build Systems & Lockfiles
BuildService -[#7CB342]-> WorkspaceMgr : 9. Allocates Isolated Build Workspaces
BuildService -[#C0CA33]-> RunnerBackend : 10. Executes Sandboxed Subprocesses
RunnerBackend -[#FDD835]-> Collector : 11. Discovers & Stream-hashes Build Artifacts
Collector -[#FFB300]-> Repositories : 12. Persists Strict SHA-256 Digest Records
CompService -[#FB8C00]-> Normalizer : 13. Normalizes Timestamps, Perms & Gzip Headers
CompService -[#F4511E]-> DiffEngine : 14. Executes Recursive Archive & File Diffs
DiffEngine -[#6D4C41]-> DiagRules : 15. Feeds Structural Findings & Content Diffs
DiagRules -[#546E7A]-> RemediationGen : 16. Generates Recommendation-only Guidance
DiagRules -[#E53935]-> Scorer : 17. Provides Classified Failure Evidence
Scorer -[#880E4F]-> CompService : 18. Produces Metric Vector & Categorical Verdict
CompService -[#4A148C]-> Repositories : 19. Persists Comparisons, Findings & Verdicts
BuildService -[#0D47A1]-> Repositories : 20. Tracks Build Lifecycle & Post-Crash Recovery
Repositories -[#1B5E20]-> SqliteDb : 21. Atomic WAL Commits with Busy Timeout
@enduml
