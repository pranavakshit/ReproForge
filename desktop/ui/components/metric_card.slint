import { Theme } from "../theme.slint";

export component MetricCard inherits Rectangle {
    in property <string> label;
    in property <string> value;
    in property <string> subtitle: "";
    in property <color> accent_color: Theme.accent-primary;

    min-height: 92px;
    background: Theme.bg-card;
    border-radius: Theme.radius-md;
    border-width: 1px;
    border-color: Theme.border-subtle;

    // Subtle top accent bar
    Rectangle {
        x: 0px;
        y: 0px;
        width: parent.width;
        height: 2px;
        background: root.accent_color;
    }

    VerticalLayout {
        padding: 14px;
        spacing: 6px;

        Text {
            text: root.label;
            color: Theme.text-secondary;
            font-size: 11px;
            font-weight: 600;
            letter-spacing: 0.4px;
        }

        Text {
            text: root.value;
            color: Theme.text-primary;
            font-size: 24px;
            font-weight: 700;
        }

        if root.subtitle != "": Text {
            text: root.subtitle;
            color: root.accent_color;
            font-size: 11px;
            font-weight: 500;
            overflow: elide;
        }
    }
}
