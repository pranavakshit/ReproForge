import { Theme } from "../theme.slint";
import { ShimmerBlock } from "shimmer.slint";

export component MetricCard inherits Rectangle {
    in property <string> title: "";
    in property <string> value: "";
    in property <string> subtitle: "";
    in property <color> value_color: Theme.text_primary;
    in property <bool> is_loading: false;
    in property <bool> motion_enabled: true;
    in property <float> shimmer_progress: 0.0;

    background: Theme.bg_secondary;
    border-radius: Theme.radius_md;
    border-width: 1px;
    border-color: Theme.border_subtle;

    VerticalLayout {
        padding: 14px;
        alignment: space-between;

        Text {
            text: root.title;
            font-size: 11px;
            font-weight: 600;
            color: Theme.text_muted;
            letter-spacing: 0.5px;
        }

        Text {
            text: root.value;
            font-size: 24px;
            font-weight: 700;
            color: root.value_color;
        }

        if root.subtitle != "": Text {
            text: root.subtitle;
            font-size: 11px;
            color: Theme.text_dim;
        }
    }

    ShimmerBlock {
        is_loading: root.is_loading;
        motion_enabled: root.motion_enabled;
        shimmer_progress: root.shimmer_progress;
    }
}
