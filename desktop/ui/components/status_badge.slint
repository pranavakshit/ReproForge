import { Theme } from "../theme.slint";

export component StatusBadge inherits Rectangle {
    in property <string> text;
    in property <string> kind: "neutral"; // success | warning | danger | info | neutral

    height: 22px;
    border-radius: Theme.radius-pill;
    border-width: 1px;

    background:
        kind == "success" ? Theme.status-success-soft :
        kind == "warning" ? Theme.status-warning-soft :
        kind == "danger" ? Theme.status-danger-soft :
        kind == "info" ? Theme.status-info-soft :
        Theme.bg-elevated;

    border-color:
        kind == "success" ? #14532D :
        kind == "warning" ? #78350F :
        kind == "danger" ? #7F1D1D :
        kind == "info" ? #164E63 :
        Theme.border-muted;

    HorizontalLayout {
        padding-left: 9px;
        padding-right: 9px;
        spacing: 5px;
        alignment: center;

        VerticalLayout {
            alignment: center;
            Rectangle {
                width: 5px;
                height: 5px;
                border-radius: 3px;
                background:
                    kind == "success" ? Theme.status-success :
                    kind == "warning" ? Theme.status-warning :
                    kind == "danger" ? Theme.status-danger :
                    kind == "info" ? Theme.status-info :
                    Theme.text-secondary;
            }
        }

        Text {
            text: root.text;
            font-size: 10.5px;
            font-weight: 600;
            vertical-alignment: center;
            color:
                kind == "success" ? #6EE7B7 :
                kind == "warning" ? #FCD34D :
                kind == "danger" ? #FCA5A5 :
                kind == "info" ? #67E8F9 :
                Theme.text-secondary;
        }
    }
}
