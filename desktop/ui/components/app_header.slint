import { Theme } from "../theme.slint";
import { IconInfo, IconSearch } from "./icons.slint";
import { ActionButton } from "./action_button.slint";

export component AppHeader inherits Rectangle {
    in property <string> active_title: "Overview";
    in property <string> engine_status: "Engine Initializing...";
    in property <bool> engine_healthy: false;
    in property <string> engine_backend: "IPC";
    in property <string> app_version: "0.2.0";
    in property <string> search_query: "";

    callback search_changed(string);
    callback refresh_requested();
    callback about_requested();

    height: 54px;
    background: Theme.bg-header;
    border-width: 0px;

    // Bottom hairline divider
    Rectangle {
        y: parent.height - 1px;
        height: 1px;
        width: parent.width;
        background: Theme.border-subtle;
    }

    HorizontalLayout {
        padding-left: 20px;
        padding-right: 20px;
        spacing: 14px;
        alignment: space-between;

        // Left: Breadcrumb / Active Section Title
        HorizontalLayout {
            spacing: 10px;
            alignment: start;

            VerticalLayout {
                alignment: center;
                Rectangle {
                    width: 8px;
                    height: 8px;
                    border-radius: 4px;
                    background: root.engine_healthy ? Theme.status-success : Theme.status-warning;
                }
            }

            VerticalLayout {
                alignment: center;
                Text {
                    text: root.active_title;
                    color: Theme.text-primary;
                    font-size: 16px;
                    font-weight: 700;
                }
            }
        }

        // Right: Compact Search, Engine Status Pill, Refresh & Info
        HorizontalLayout {
            spacing: 10px;
            alignment: end;

            // Search Bar
            VerticalLayout {
                alignment: center;
                Rectangle {
                    width: 210px;
                    height: 30px;
                    border-radius: Theme.radius-sm;
                    background: Theme.bg-input;
                    border-width: 1px;
                    border-color: search-input.has-focus ? Theme.border-active : Theme.border-subtle;

                    HorizontalLayout {
                        padding-left: 9px;
                        padding-right: 9px;
                        spacing: 7px;

                        VerticalLayout {
                            alignment: center;
                            IconSearch {
                                icon-size: 13px;
                                icon-color: Theme.text-muted;
                            }
                        }

                        search-input := TextInput {
                            text: root.search_query;
                            color: Theme.text-primary;
                            font-size: 12px;
                            vertical-alignment: center;
                            single-line: true;
                            horizontal-stretch: 1;
                            edited => { root.search_changed(self.text); }
                        }
                    }

                    if search-input.text == "" && !search-input.has-focus: Text {
                        x: 29px;
                        y: 7px;
                        text: "Filter items (Ctrl+K)...";
                        color: Theme.text-muted;
                        font-size: 11.5px;
                    }
                }
            }

            // Engine Health Pill
            VerticalLayout {
                alignment: center;
                Rectangle {
                    height: 28px;
                    border-radius: Theme.radius-pill;
                    background: root.engine_healthy ? Theme.status-success-soft : Theme.status-warning-soft;
                    border-width: 1px;
                    border-color: root.engine_healthy ? #14532D : #78350F;

                    HorizontalLayout {
                        padding-left: 10px;
                        padding-right: 10px;
                        spacing: 6px;

                        VerticalLayout {
                            alignment: center;
                            Rectangle {
                                width: 6px;
                                height: 6px;
                                border-radius: 3px;
                                background: root.engine_healthy ? Theme.status-success : Theme.status-warning;
                            }
                        }

                        Text {
                            text: root.engine_healthy ? ("IPC Active • " + root.engine_backend) : root.engine_status;
                            color: root.engine_healthy ? #6EE7B7 : #FCD34D;
                            font-size: 11px;
                            font-weight: 600;
                            vertical-alignment: center;
                        }
                    }
                }
            }

            // Refresh Button
            VerticalLayout {
                alignment: center;
                ActionButton {
                    label: "Sync";
                    variant: "secondary";
                    btn-height: 30px;
                    h-pad: 12px;
                    clicked => { root.refresh_requested(); }
                }
            }

            // Info Modal Trigger
            VerticalLayout {
                alignment: center;
                Rectangle {
                    width: 30px;
                    height: 30px;
                    border-radius: Theme.radius-sm;
                    background: info-ta.has-hover ? Theme.bg-hover : Theme.bg-card;
                    border-width: 1px;
                    border-color: info-ta.has-hover ? Theme.border-active : Theme.border-subtle;

                    VerticalLayout {
                        alignment: center;
                        HorizontalLayout {
                            alignment: center;
                            IconInfo {
                                icon-size: 15px;
                                icon-color: info-ta.has-hover ? Theme.text-primary : Theme.text-secondary;
                            }
                        }
                    }

                    info-ta := TouchArea {
                        mouse-cursor: pointer;
                        clicked => { root.about_requested(); }
                    }
                }
            }
        }
    }
}
