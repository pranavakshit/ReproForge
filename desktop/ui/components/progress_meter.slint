import { Theme } from "../theme.slint";

export component ProgressMeter inherits VerticalLayout {
    in property <string> label;
    in property <float> ratio: 0.0; // 0.0 to 1.0
    in property <string> value-text: "";
    in property <color> fill-color: Theme.accent-primary;

    spacing: 5px;

    HorizontalLayout {
        Text {
            text: root.label;
            color: Theme.text-secondary;
            font-size: 11.5px;
            font-weight: 500;
            horizontal-stretch: 1;
        }
        Text {
            text: root.value-text != "" ? root.value-text : (Math.round(root.ratio * 100.0) + "%");
            color: Theme.text-primary;
            font-size: 11.5px;
            font-weight: 700;
        }
    }

    Rectangle {
        height: 6px;
        background: Theme.bg-input;
        border-radius: 3px;
        border-width: 1px;
        border-color: Theme.border-subtle;
        clip: true;

        Rectangle {
            x: 0;
            y: 0;
            height: parent.height;
            width: Math.max(0px, Math.min(1.0, root.ratio) * parent.width);
            border-radius: 3px;
            background: root.fill-color;
        }
    }
}
