import { Theme } from "../theme.slint";

component VectorGlyph inherits Rectangle {
    in property <string> path-data;
    in property <brush> icon-color: Theme.text-secondary;
    in property <length> icon-size: 16px;
    in property <bool> filled: false;
    in property <length> stroke-w: 1.75px;

    width: root.icon-size;
    height: root.icon-size;

    Path {
        width: parent.width;
        height: parent.height;
        viewbox-x: 0;
        viewbox-y: 0;
        viewbox-width: 24;
        viewbox-height: 24;
        fill: root.filled ? root.icon-color : transparent;
        stroke: root.filled ? transparent : root.icon-color;
        stroke-width: root.filled ? 0px : root.stroke-w;
        commands: root.path-data;
    }
}

