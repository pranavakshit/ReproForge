import { Theme } from "../theme.slint";
import { ActionButton } from "./action_button.slint";

export component AboutModal inherits Rectangle {
    in property <bool> show: false;
    in property <string> version: "0.2.0";
    in property <string> protocol: "1.0.0";
    callback close_requested();

    if show: Rectangle {
        x: 0;
        y: 0;
        width: 100%;
        height: 100%;
        background: #04070CCC;
        z: 100;

        TouchArea {
            clicked => { root.close_requested(); }
        }

        VerticalLayout {
            alignment: center;
            HorizontalLayout {
                alignment: center;

                Rectangle {
                    width: 470px;
                    background: Theme.bg-card;
                    border-radius: Theme.radius-lg;
                    border-width: 1px;
                    border-color: Theme.border-muted;

                    // Block click-through on modal card
                    TouchArea {}

                    VerticalLayout {
                        padding: 24px;
                        spacing: 14px;

                        HorizontalLayout {
                            spacing: 12px;
                            Rectangle {
                                width: 40px;
                                height: 40px;
                                border-radius: Theme.radius-md;
                                background: Theme.accent-primary-soft;
                                border-width: 1px;
                                border-color: Theme.accent-primary;
                                Text {
                                    text: "RF";
                                    color: #93C5FD;
                                    font-size: 16px;
                                    font-weight: 800;
                                    horizontal-alignment: center;
                                    vertical-alignment: center;
                                }
                            }
                            VerticalLayout {
                                spacing: 2px;
                                Text {
                                    text: "ReproForge Desktop Studio";
                                    color: Theme.text-primary;
                                    font-size: 18px;
                                    font-weight: 700;
                                }
                                Text {
                                    text: "Build Reproducibility & Drift Diagnostics";
                                    color: Theme.text-secondary;
                                    font-size: 12px;
                                }
                            }
                        }

                        Rectangle { height: 1px; background: Theme.border-subtle; }

                        GridLayout {
                            spacing: 8px;
                            Row {
                                Text { text: "Desktop Shell"; color: Theme.text-muted; font-size: 12px; }
                                Text { text: "Slint " + "1.19 + Rust (" + root.version + ")"; color: Theme.text-primary; font-size: 12px; font-weight: 600; }
                            }
                            Row {
                                Text { text: "Backend IPC"; color: Theme.text-muted; font-size: 12px; }
                                Text { text: "JSON-RPC 2.0 over stdio (v" + root.protocol + ")"; color: Theme.text-primary; font-size: 12px; font-weight: 600; }
                            }
                            Row {
                                Text { text: "Project"; color: Theme.text-muted; font-size: 12px; }
                                Text { text: "UPES CSDV4009P Software Engineering"; color: Theme.text-secondary; font-size: 12px; }
                            }
                        }

                        Rectangle { height: 1px; background: Theme.border-subtle; }

                        Text {
                            text: "Zero-bloat native desktop workstation backed by SQLite, normalized archive comparison, rule-based RCA diagnostics, controlled perturbation testing, and isolated build sandboxes.";
                            color: Theme.text-secondary;
                            font-size: 11.5px;
                            wrap: word-wrap;
                        }

                        HorizontalLayout {
                            alignment: end;
                            ActionButton {
                                label: "Close";
                                variant: "primary";
                                clicked => { root.close_requested(); }
                            }
                        }
                    }
                }
            }
        }
    }
}
