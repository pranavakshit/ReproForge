import { Theme } from "../theme.slint";

export component PanelCard inherits Rectangle {
    in property <string> title: "";
    in property <string> subtitle: "";
    in property <brush> header-accent: Theme.text-primary;
    in property <length> inner-padding: 16px;
    in property <length> inner-spacing: 12px;
    in property <color> surface-bg: Theme.bg-card;

    background: root.surface-bg;
    border-radius: Theme.radius-md;
    border-width: 1px;
    border-color: Theme.border-subtle;

    VerticalLayout {
        padding: root.inner-padding;
        spacing: root.inner-spacing;

        if root.title != "": VerticalLayout {
            spacing: 2px;
            Text {
                text: root.title;
                color: root.header-accent;
                font-size: 13.5px;
                font-weight: 700;
            }
            if root.subtitle != "": Text {
                text: root.subtitle;
                color: Theme.text-muted;
                font-size: 11px;
            }
        }

        @children
    }
}
