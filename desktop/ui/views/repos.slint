import { Theme } from "../theme.slint";

export struct RepoItem {
    id: string,
    name: string,
    remote_url: string,
    default_branch: string,
    build_system: string,
    revisions_count: int,
}

export struct RevisionItem {
    commit_sha: string,
    author: string,
    message: string,
    timestamp: string,
    is_pinned: bool,
}

export component RepositoriesView inherits Rectangle {
    in property <[RepoItem]> repositories: [];
    in property <int> selected_repo_index: 0;
    in property <[RevisionItem]> revisions: [];

    callback repo_selected(int);
    callback register_local_repo_clicked();
    callback build_revision_clicked(string);

    background: Theme.bg_primary;

    VerticalLayout {
        padding: 20px;
        spacing: 16px;
        alignment: start;

        // View Header
        HorizontalLayout {
            alignment: space-between;
            HorizontalLayout {
                spacing: 10px;
                Text {
                    text: "Tracked Repositories & Revisions";
                    font-size: 18px;
                    font-weight: 700;
                    color: Theme.text_primary;
                    vertical-alignment: center;
                }
                Rectangle {
                    height: 20px;
                    border-radius: Theme.radius_sm;
                    background: Theme.bg_card;
                    border-width: 1px;
                    border-color: Theme.status_exact;
                    HorizontalLayout {
                        padding-left: 6px; padding-right: 6px; alignment: center;
                        Text { text: "Live Git & Repos"; font-size: 10px; font-weight: 600; color: Theme.status_exact; vertical-alignment: center; }
                    }
                }
            }

            // Register Local Repo Action Button
            Rectangle {
                width: 160px;
                height: 28px;
                border-radius: Theme.radius_sm;
                background: reg_touch.has_hover ? Theme.accent_blue_hover : Theme.accent_blue;

                reg_touch := TouchArea {
                    clicked => { root.register_local_repo_clicked(); }
                }

                HorizontalLayout {
                    alignment: center;
                    spacing: 6px;
                    Text { text: "+ Sync Local Repo"; font-size: 11px; font-weight: 600; color: #FFFFFF; vertical-alignment: center; }
                }
            }
        }

        // Master-Detail Split
        HorizontalLayout {
            spacing: 16px;

            // Master: Repository List
            Rectangle {
                width: 320px;
                height: 520px;
                background: Theme.bg_secondary;
                border-radius: Theme.radius_md;
                border-width: 1px;
                border-color: Theme.border_subtle;

                VerticalLayout {
                    padding: 12px;
                    spacing: 8px;

                    Text {
                        text: "REGISTERED REPOSITORIES";
                        font-size: 11px;
                        font-weight: 600;
                        color: Theme.text_muted;
                        letter-spacing: 0.5px;
                        padding-bottom: 4px;
                    }

                    for repo[idx] in root.repositories : Rectangle {
                        height: 72px;
                        border-radius: Theme.radius_md;
                        background: (root.selected_repo_index == idx) ? Theme.bg_active :
                                    (repo_touch.has_hover ? Theme.bg_hover : Theme.bg_card);
                        border-width: 1px;
                        border-color: (root.selected_repo_index == idx) ? Theme.border_accent : Theme.border_subtle;

                        repo_touch := TouchArea {
                            clicked => { root.repo_selected(idx); }
                        }

                        VerticalLayout {
                            padding: 10px;
                            alignment: space-between;

                            HorizontalLayout {
                                alignment: space-between;
                                Text {
                                    text: repo.name;
                                    font-size: 13px;
                                    font-weight: 600;
                                    color: (root.selected_repo_index == idx) ? Theme.accent_cyan : Theme.text_primary;
                                }
                                Rectangle {
                                    height: 18px;
                                    border-radius: Theme.radius_sm;
                                    background: Theme.bg_elevated;
                                    HorizontalLayout {
                                        padding-left: 6px; padding-right: 6px; alignment: center;
                                        Text { text: repo.build_system; font-size: 9px; font-weight: 600; color: Theme.text_secondary; }
                                    }
                                }
                            }

                            Text {
                                text: repo.remote_url;
                                font-size: 10px;
                                color: Theme.text_dim;
                                overflow: elide;
                            }

                            HorizontalLayout {
                                alignment: space-between;
                                Text { text: "Branch: " + repo.default_branch; font-size: 10px; color: Theme.text_muted; }
                                Text { text: repo.revisions_count + " builds"; font-size: 10px; color: Theme.text_muted; }
                            }
                        }
                    }
                }
            }

            // Detail: Revision History & Detected Configuration
            Rectangle {
                horizontal-stretch: 1;
                height: 520px;
                background: Theme.bg_secondary;
                border-radius: Theme.radius_md;
                border-width: 1px;
                border-color: Theme.border_subtle;

                VerticalLayout {
                    padding: 16px;
                    spacing: 12px;

                    // Detail Header
                    HorizontalLayout {
                        alignment: space-between;
                        VerticalLayout {
                            spacing: 4px;
                            Text {
                                text: "Git Revisions & Build Configuration";
                                font-size: 14px;
                                font-weight: 700;
                                color: Theme.text_primary;
                            }
                            Text {
                                text: "Deterministic commit pinning and isolation metadata";
                                font-size: 11px;
                                color: Theme.text_dim;
                            }
                        }
                    }

                    // Configuration Card
                    Rectangle {
                        height: 70px;
                        background: Theme.bg_card;
                        border-radius: Theme.radius_md;
                        border-width: 1px;
                        border-color: Theme.border_subtle;

                        HorizontalLayout {
                            padding: 12px;
                            spacing: 20px;
                            alignment: space-between;

                            VerticalLayout {
                                spacing: 4px;
                                Text { text: "BUILD SPECIFICATION"; font-size: 10px; font-weight: 600; color: Theme.text_dim; }
                                Text { text: "Multi-stage Dockerfile"; font-size: 12px; font-weight: 600; color: Theme.accent_cyan; }
                            }
                            VerticalLayout {
                                spacing: 4px;
                                Text { text: "ISOLATION PROFILE"; font-size: 10px; font-weight: 600; color: Theme.text_dim; }
                                Text { text: "BuildKit Sandbox (Network Gated)"; font-size: 12px; font-weight: 600; color: Theme.status_exact; }
                            }
                            VerticalLayout {
                                spacing: 4px;
                                Text { text: "TIMESTAMP CLAMPING"; font-size: 10px; font-weight: 600; color: Theme.text_dim; }
                                Text { text: "SOURCE_DATE_EPOCH=1700000000"; font-size: 12px; color: Theme.text_secondary; }
                            }
                        }
                    }

                    Text {
                        text: "PINNED REVISIONS";
                        font-size: 11px;
                        font-weight: 600;
                        color: Theme.text_muted;
                        letter-spacing: 0.5px;
                        padding-top: 4px;
                    }

                    // Revision List
                    for rev in root.revisions : Rectangle {
                        height: 52px;
                        background: Theme.bg_card;
                        border-radius: Theme.radius_sm;
                        border-width: 1px;
                        border-color: Theme.border_subtle;

                        HorizontalLayout {
                            padding-left: 12px; padding-right: 12px;
                            alignment: space-between;

                            VerticalLayout {
                                alignment: center;
                                spacing: 3px;
                                HorizontalLayout {
                                    spacing: 8px;
                                    Text { text: rev.commit_sha; font-size: 12px; font-weight: 700; color: Theme.text_primary; }
                                    if rev.is_pinned : Rectangle {
                                        height: 16px; border-radius: Theme.radius_sm; background: Theme.status_exact_bg;
                                        HorizontalLayout {
                                            padding-left: 6px; padding-right: 6px; alignment: center;
                                            Text { text: "PINNED TARGET"; font-size: 9px; font-weight: 700; color: Theme.status_exact; }
                                        }
                                    }
                                }
                                Text { text: rev.message; font-size: 11px; color: Theme.text_secondary; }
                            }

                            HorizontalLayout {
                                spacing: 12px;
                                alignment: center;

                                VerticalLayout {
                                    alignment: center;
                                    Text { text: rev.author; font-size: 11px; color: Theme.text_muted; horizontal-alignment: end; }
                                    Text { text: rev.timestamp; font-size: 10px; color: Theme.text_dim; horizontal-alignment: end; }
                                }

                                Rectangle {
                                    width: 76px;
                                    height: 26px;
                                    border-radius: Theme.radius_sm;
                                    background: bld_touch.has_hover ? Theme.status_exact : Theme.status_exact_bg;
                                    border-width: 1px;
                                    border-color: Theme.status_exact;

                                    bld_touch := TouchArea {
                                        clicked => { root.build_revision_clicked(rev.commit_sha); }
                                    }

                                    HorizontalLayout {
                                        alignment: center;
                                        Text {
                                            text: "▶ Run Build";
                                            font-size: 10px;
                                            font-weight: 700;
                                            color: bld_touch.has_hover ? #FFFFFF : Theme.status_exact;
                                            vertical-alignment: center;
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
    }
}
