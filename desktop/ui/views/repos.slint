import { ListView } from "std-widgets.slint";
import { Theme } from "../theme.slint";
import { ActionButton } from "../components/action_button.slint";
import { PanelCard } from "../components/panel_card.slint";
import { StatusBadge } from "../components/status_badge.slint";
import { IconFolder, IconGitHub, IconRefresh, IconPlay, IconCheck } from "../components/icons.slint";

export struct RepoItem {
    id: string,
    name: string,
    url: string,
    branch: string,
    build_system: string,
    revisions_count: int,
    github_slug: string,
    upstream_url: string,
    readiness_status: string,
    readiness_warnings: string,
    last_scanned: string,
}

export struct RevisionItem {
    sha: string,
    message: string,
    author: string,
    date: string,
}

export struct WorkspaceCandidateItem {
    name: string,
    repo_path: string,
    default_branch: string,
    github_slug: string,
    upstream_url: string,
    already_tracked: bool,
    checked: bool,
}

export component ReposView inherits Rectangle {
    in property <[RepoItem]> repos: [];
    in-out property <int> selected_repo_idx: 0;
    in property <[RevisionItem]> revisions: [];
    in-out property <int> selected_revision_idx: 0;

    in-out property <string> repo_input_path: "";
    in-out property <bool> fetch_online_github: true;
    in property <[WorkspaceCandidateItem]> workspace_candidates: [];
    in property <bool> show_workspace_checklist: false;
    in property <string> workspace_folder_path: "";
    in property <string> workspace_checklist_status: "";

    callback repo_selected(int);
    callback revision_selected(int);
    callback browse_folder_requested();
    callback scan_folder_requested(string);
    callback autoscan_repo_requested();
    callback checklist_item_toggled(int);
    callback checklist_select_all_untracked();
    callback confirm_workspace_checklist();
    callback dismiss_workspace_checklist();
    callback build_revision_requested(string);
    callback verify_pair_requested();

    background: Theme.bg-canvas;

    VerticalLayout {
        padding: 20px;
        spacing: 14px;

        // Top Folder / GitHub Autoscan Bar
        PanelCard {
            inner-padding: 12px;
            inner-spacing: 10px;

            HorizontalLayout {
                spacing: 10px;

                Rectangle {
                    horizontal-stretch: 1;
                    height: 34px;
                    background: Theme.bg-input;
                    border-radius: Theme.radius-sm;
                    border-width: 1px;
                    border-color: path-edit.has-focus ? Theme.border-active : Theme.border-subtle;

                    HorizontalLayout {
                        padding-left: 10px;
                        padding-right: 10px;
                        spacing: 8px;

                        VerticalLayout {
                            alignment: center;
                            IconFolder { icon-size: 14px; icon-color: Theme.text-muted; }
                        }

                        path-edit := TextInput {
                            text <=> root.repo_input_path;
                            color: Theme.text-primary;
                            font-size: 12px;
                            vertical-alignment: center;
                            single-line: true;
                            horizontal-stretch: 1;
                            accepted => { root.scan_folder_requested(root.repo_input_path); }
                        }
                    }

                    if path-edit.text == "" && !path-edit.has-focus: Text {
                        x: 32px;
                        y: 9px;
                        text: "Paste local repo, workspace folder (e.g. D:\\Repositories), or GitHub URL...";
                        color: Theme.text-muted;
                        font-size: 11.5px;
                    }
                }

                // Online GitHub API Toggle Pill
                Rectangle {
                    height: 34px;
                    border-radius: Theme.radius-sm;
                    background: root.fetch_online_github ? Theme.accent-primary-soft : Theme.bg-elevated;
                    border-width: 1px;
                    border-color: root.fetch_online_github ? #264882 : Theme.border-muted;

                    HorizontalLayout {
                        padding-left: 10px;
                        padding-right: 10px;
                        spacing: 6px;

                        VerticalLayout {
                            alignment: center;
                            Rectangle {
                                width: 14px;
                                height: 14px;
                                border-radius: 3px;
                                background: root.fetch_online_github ? Theme.accent-primary : Theme.bg-input;
                                border-width: 1px;
                                border-color: root.fetch_online_github ? Theme.accent-primary : Theme.border-muted;
                                if root.fetch_online_github: VerticalLayout {
                                    alignment: center;
                                    HorizontalLayout {
                                        alignment: center;
                                        IconCheck { icon-size: 10px; icon-color: #FFFFFF; stroke-w: 2.4px; }
                                    }
                                }
                            }
                        }

                        Text {
                            text: "GitHub API";
                            color: root.fetch_online_github ? #93C5FD : Theme.text-secondary;
                            font-size: 11.5px;
                            font-weight: 600;
                            vertical-alignment: center;
                        }
                    }

                    TouchArea {
                        mouse-cursor: pointer;
                        clicked => { root.fetch_online_github = !root.fetch_online_github; }
                    }
                }

                ActionButton {
                    label: "Browse Folder";
                    variant: "secondary";
                    btn-height: 34px;
                    clicked => { root.browse_folder_requested(); }
                    IconFolder { icon-size: 13px; icon-color: Theme.text-secondary; }
                }

                ActionButton {
                    label: "Scan & Track";
                    variant: "primary";
                    btn-height: 34px;
                    clicked => { root.scan_folder_requested(root.repo_input_path); }
                    IconGitHub { icon-size: 13px; icon-color: #FFFFFF; }
                }
            }
        }

        // Main Split Pane: Tracked Repositories + Detail Inspector
        HorizontalLayout {
            vertical-stretch: 1;
            spacing: 16px;

            // Left Tracked Repositories List
            PanelCard {
                width: 340px;
                title: "Tracked Repositories (" + root.repos.length + ")";
                subtitle: "Select a repository to view GitHub upstream & commits";

                ListView {
                    vertical-stretch: 1;
                    for repo[idx] in root.repos: Rectangle {
                        height: 76px;
                        border-radius: Theme.radius-sm;
                        background: idx == root.selected_repo_idx ? Theme.accent-primary-soft : (r-ta.has-hover ? Theme.bg-hover : Theme.bg-elevated);
                        border-width: 1px;
                        border-color: idx == root.selected_repo_idx ? Theme.accent-primary : Theme.border-subtle;

                        VerticalLayout {
                            padding: 10px;
                            spacing: 5px;

                            HorizontalLayout {
                                spacing: 6px;
                                Text {
                                    text: repo.name;
                                    color: Theme.text-primary;
                                    font-size: 13px;
                                    font-weight: 700;
                                    horizontal-stretch: 1;
                                    overflow: elide;
                                    vertical-alignment: center;
                                }
                                StatusBadge {
                                    text: repo.build_system;
                                    kind: "info";
                                }
                            }

                            HorizontalLayout {
                                spacing: 6px;
                                if repo.github_slug != "": HorizontalLayout {
                                    spacing: 4px;
                                    horizontal-stretch: 1;
                                    VerticalLayout {
                                        alignment: center;
                                        IconGitHub { icon-size: 12px; icon-color: Theme.accent-cyan; }
                                    }
                                    Text {
                                        text: repo.github_slug;
                                        color: Theme.accent-cyan;
                                        font-size: 11px;
                                        font-weight: 500;
                                        overflow: elide;
                                        vertical-alignment: center;
                                    }
                                }
                                if repo.github_slug == "": Text {
                                    text: repo.url;
                                    color: Theme.text-muted;
                                    font-size: 10.5px;
                                    horizontal-stretch: 1;
                                    overflow: elide;
                                    vertical-alignment: center;
                                }
                                Text {
                                    text: repo.branch;
                                    color: Theme.text-secondary;
                                    font-size: 10.5px;
                                    vertical-alignment: center;
                                }
                            }
                        }

                        r-ta := TouchArea {
                            mouse-cursor: pointer;
                            clicked => {
                                root.selected_repo_idx = idx;
                                root.repo_selected(idx);
                            }
                        }
                    }
                }
            }

            // Right Repository & GitHub Audit + Revisions
            VerticalLayout {
                horizontal-stretch: 1;
                spacing: 14px;

                if root.selected_repo_idx >= 0 && root.selected_repo_idx < root.repos.length: PanelCard {
                    title: root.repos[root.selected_repo_idx].name;
                    subtitle: root.repos[root.selected_repo_idx].url;

                    HorizontalLayout {
                        spacing: 10px;
                        alignment: space-between;

                        HorizontalLayout {
                            spacing: 8px;
                            StatusBadge {
                                text: root.repos[root.selected_repo_idx].github_slug != "" ? ("GitHub: " + root.repos[root.selected_repo_idx].github_slug) : "Local Repo Only";
                                kind: root.repos[root.selected_repo_idx].github_slug != "" ? "info" : "neutral";
                            }
                            StatusBadge {
                                text: "Readiness: " + root.repos[root.selected_repo_idx].readiness_status;
                                kind: root.repos[root.selected_repo_idx].readiness_status == "ready" ? "success" : "warning";
                            }
                            StatusBadge {
                                text: root.repos[root.selected_repo_idx].revisions_count + " commits";
                                kind: "neutral";
                            }
                        }

                        HorizontalLayout {
                            spacing: 8px;
                            ActionButton {
                                label: "Verify Reproducibility (2x Build + Compare)";
                                variant: "primary";
                                btn-height: 28px;
                                clicked => { root.verify_pair_requested(); }
                                IconPlay { icon-size: 11px; icon-color: #FFFFFF; }
                            }
                            ActionButton {
                                label: "Re-Scan GitHub";
                                variant: "secondary";
                                btn-height: 28px;
                                clicked => { root.autoscan_repo_requested(); }
                                IconRefresh { icon-size: 12px; icon-color: Theme.text-secondary; }
                            }
                        }
                    }

                    if root.repos[root.selected_repo_idx].readiness_warnings != "": Rectangle {
                        background: Theme.status-warning-soft;
                        border-radius: Theme.radius-sm;
                        border-width: 1px;
                        border-color: #78350F;

                        VerticalLayout {
                            padding: 9px;
                            spacing: 2px;
                            Text {
                                text: "Static Readiness & Upstream Audit Findings";
                                color: #FCD34D;
                                font-size: 11px;
                                font-weight: 700;
                            }
                            Text {
                                text: root.repos[root.selected_repo_idx].readiness_warnings;
                                color: #FDE68A;
                                font-size: 11px;
                                wrap: word-wrap;
                            }
                        }
                    }
                }

                PanelCard {
                    vertical-stretch: 1;
                    title: "Git Revision History";
                    subtitle: "Clean deterministic commit targets exported via git archive";

                    if root.revisions.length == 0: Rectangle {
                        vertical-stretch: 1;
                        Text {
                            text: "No git commits loaded for this repository yet.";
                            color: Theme.text-muted;
                            font-size: 12px;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }
                    }

                    if root.revisions.length > 0: ListView {
                        vertical-stretch: 1;
                        for rev[idx] in root.revisions: Rectangle {
                            height: 52px;
                            border-radius: Theme.radius-sm;
                            background: idx == root.selected_revision_idx ? Theme.accent-primary-soft : (rev-ta.has-hover ? Theme.bg-hover : transparent);
                            border-width: 1px;
                            border-color: idx == root.selected_revision_idx ? #264882 : Theme.border-subtle;

                            HorizontalLayout {
                                padding-left: 12px;
                                padding-right: 12px;
                                spacing: 12px;

                                VerticalLayout {
                                    alignment: center;
                                    width: 74px;
                                    Rectangle {
                                        height: 22px;
                                        border-radius: Theme.radius-xs;
                                        background: Theme.bg-input;
                                        border-width: 1px;
                                        border-color: Theme.border-muted;
                                        Text {
                                            text: rev.sha;
                                            color: Theme.accent-cyan;
                                            font-size: 11px;
                                            font-weight: 700;
                                            horizontal-alignment: center;
                                            vertical-alignment: center;
                                        }
                                    }
                                }

                                VerticalLayout {
                                    alignment: center;
                                    horizontal-stretch: 1;
                                    spacing: 2px;
                                    Text {
                                        text: rev.message;
                                        color: Theme.text-primary;
                                        font-size: 12px;
                                        font-weight: 600;
                                        overflow: elide;
                                    }
                                    Text {
                                        text: rev.author + " • " + rev.date;
                                        color: Theme.text-muted;
                                        font-size: 10.5px;
                                    }
                                }

                                VerticalLayout {
                                    alignment: center;
                                    ActionButton {
                                        label: "Build";
                                        variant: "secondary";
                                        btn-height: 26px;
                                        h-pad: 10px;
                                        font-size: 11px;
                                        clicked => { root.build_revision_requested(rev.sha); }
                                        IconPlay { icon-size: 10px; icon-color: Theme.status-success; }
                                    }
                                }
                            }

                            rev-ta := TouchArea {
                                mouse-cursor: pointer;
                                clicked => {
                                    root.selected_revision_idx = idx;
                                    root.revision_selected(idx);
                                }
                            }
                        }
                    }
                }
            }
        }
    }

    // Parent Workspace Selectable Checklist Modal
    if root.show_workspace_checklist: Rectangle {
        x: 0;
        y: 0;
        width: 100%;
        height: 100%;
        background: #04070CD9;
        z: 50;

        TouchArea {
            clicked => { root.dismiss_workspace_checklist(); }
        }

        VerticalLayout {
            alignment: center;
            HorizontalLayout {
                alignment: center;

                Rectangle {
                    width: 680px;
                    height: 500px;
                    background: Theme.bg-card;
                    border-radius: Theme.radius-lg;
                    border-width: 1px;
                    border-color: Theme.border-muted;

                    TouchArea {}

                    VerticalLayout {
                        padding: 20px;
                        spacing: 12px;

                        HorizontalLayout {
                            alignment: space-between;
                            VerticalLayout {
                                spacing: 3px;
                                Text {
                                    text: "Select Repositories to Track";
                                    color: Theme.text-primary;
                                    font-size: 16px;
                                    font-weight: 700;
                                }
                                Text {
                                    text: "Workspace folder: " + root.workspace_folder_path;
                                    color: Theme.text-muted;
                                    font-size: 11px;
                                    overflow: elide;
                                }
                            }
                            ActionButton {
                                label: "Select Untracked";
                                variant: "ghost";
                                btn-height: 28px;
                                clicked => { root.checklist_select_all_untracked(); }
                            }
                        }

                        Rectangle { height: 1px; background: Theme.border-subtle; }

                        ListView {
                            vertical-stretch: 1;
                            for cand[idx] in root.workspace_candidates: Rectangle {
                                height: 54px;
                                border-radius: Theme.radius-sm;
                                background: cand.checked ? Theme.accent-primary-soft : (c-ta.has-hover ? Theme.bg-hover : Theme.bg-elevated);
                                border-width: 1px;
                                border-color: cand.checked ? Theme.accent-primary : Theme.border-subtle;

                                HorizontalLayout {
                                    padding-left: 12px;
                                    padding-right: 12px;
                                    spacing: 10px;

                                    VerticalLayout {
                                        alignment: center;
                                        Rectangle {
                                            width: 16px;
                                            height: 16px;
                                            border-radius: 4px;
                                            background: cand.checked ? Theme.accent-primary : Theme.bg-input;
                                            border-width: 1px;
                                            border-color: cand.checked ? Theme.accent-primary : Theme.border-muted;
                                            if cand.checked: VerticalLayout {
                                                alignment: center;
                                                HorizontalLayout {
                                                    alignment: center;
                                                    IconCheck { icon-size: 11px; icon-color: #FFFFFF; stroke-w: 2.5px; }
                                                }
                                            }
                                        }
                                    }

                                    VerticalLayout {
                                        alignment: center;
                                        horizontal-stretch: 1;
                                        spacing: 2px;
                                        HorizontalLayout {
                                            spacing: 8px;
                                            Text {
                                                text: cand.name;
                                                color: Theme.text-primary;
                                                font-size: 12.5px;
                                                font-weight: 700;
                                            }
                                            if cand.github_slug != "": Text {
                                                text: cand.github_slug;
                                                color: Theme.accent-cyan;
                                                font-size: 11px;
                                                vertical-alignment: center;
                                            }
                                        }
                                        Text {
                                            text: cand.repo_path;
                                            color: Theme.text-muted;
                                            font-size: 10.5px;
                                            overflow: elide;
                                        }
                                    }

                                    VerticalLayout {
                                        alignment: center;
                                        StatusBadge {
                                            text: cand.already_tracked ? "Tracked" : cand.default_branch;
                                            kind: cand.already_tracked ? "success" : "neutral";
                                        }
                                    }
                                }

                                c-ta := TouchArea {
                                    mouse-cursor: pointer;
                                    clicked => { root.checklist_item_toggled(idx); }
                                }
                            }
                        }

                        Rectangle { height: 1px; background: Theme.border-subtle; }

                        HorizontalLayout {
                            alignment: space-between;
                            Text {
                                text: root.workspace_checklist_status;
                                color: Theme.text-secondary;
                                font-size: 11.5px;
                                vertical-alignment: center;
                            }
                            HorizontalLayout {
                                spacing: 10px;
                                ActionButton {
                                    label: "Cancel";
                                    variant: "secondary";
                                    clicked => { root.dismiss_workspace_checklist(); }
                                }
                                ActionButton {
                                    label: "Track & Autoscan Selected";
                                    variant: "primary";
                                    clicked => { root.confirm_workspace_checklist(); }
                                }
                            }
                        }
                    }
                }
            }
        }
    }
}
