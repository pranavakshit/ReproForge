import { ListView } from "std-widgets.slint";
import { Theme } from "../theme.slint";
import { ActionButton } from "../components/action_button.slint";
import { PanelCard } from "../components/panel_card.slint";
import { StatusBadge } from "../components/status_badge.slint";
import { IconLab } from "../components/icons.slint";

export struct PerturbationParam {
    name: string,
    baseline_val: string,
    perturbed_val: string,
    description: string,
    enabled: bool,
}

export struct SensitivityResult {
    param_name: string,
    baseline_verdict: string,
    perturbed_verdict: string,
    hash_changed: bool,
    causal_impact: string,
    epistemic_status: string,
}

export component PerturbationView inherits Rectangle {
    in property <[PerturbationParam]> params: [];
    in property <[SensitivityResult]> results: [];
    in property <bool> is_running: false;

    callback run_campaign_requested();

    background: Theme.bg-canvas;

    VerticalLayout {
        padding: 20px;
        spacing: 14px;

        PanelCard {
            inner-padding: 12px;
            HorizontalLayout {
                alignment: space-between;
                spacing: 12px;
                VerticalLayout {
                    spacing: 2px;
                    Text {
                        text: "Single-Variable Perturbation & Sensitivity Lab";
                        color: Theme.text-primary;
                        font-size: 14px;
                        font-weight: 700;
                    }
                    Text {
                        text: "Isolate causal variables across clean exported git commits with confounder guard";
                        color: Theme.text-secondary;
                        font-size: 11.5px;
                    }
                }
                ActionButton {
                    label: root.is_running ? "Campaign Running..." : "Run Sensitivity Campaign";
                    variant: "primary";
                    btn-height: 32px;
                    disabled: root.is_running;
                    clicked => { root.run_campaign_requested(); }
                    IconLab { icon-size: 13px; icon-color: #FFFFFF; }
                }
            }
        }

        HorizontalLayout {
            vertical-stretch: 1;
            spacing: 16px;

            PanelCard {
                horizontal-stretch: 2;
                title: "Experimental Variable Matrix (" + root.params.length + ")";
                subtitle: "Controlled single-variable deltas (SOURCE_DATE_EPOCH, TZ, LC_ALL, umask)";

                if root.params.length == 0: Rectangle {
                    vertical-stretch: 1;
                    Text {
                        text: "Load campaign parameters from backend.";
                        color: Theme.text-muted;
                        font-size: 12px;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                }

                if root.params.length > 0: ListView {
                    vertical-stretch: 1;
                    for p in root.params: Rectangle {
                        height: 66px;
                        background: Theme.bg-elevated;
                        border-radius: Theme.radius-sm;
                        border-width: 1px;
                        border-color: Theme.border-subtle;

                        VerticalLayout {
                            padding: 10px;
                            spacing: 4px;
                            HorizontalLayout {
                                alignment: space-between;
                                Text { text: p.name; color: Theme.accent-cyan; font-size: 12px; font-weight: 700; }
                                StatusBadge { text: p.enabled ? "ACTIVE" : "DISABLED"; kind: p.enabled ? "info" : "neutral"; }
                            }
                            Text {
                                text: p.baseline_val + "  ->  " + p.perturbed_val + "  •  " + p.description;
                                color: Theme.text-secondary;
                                font-size: 11px;
                                overflow: elide;
                            }
                        }
                    }
                }
            }

            PanelCard {
                horizontal-stretch: 3;
                title: "Sensitivity Response Results (" + root.results.length + ")";
                subtitle: "Hash drift verification promoting HYPOTHESIS -> EXPERIMENTALLY_VALIDATED";

                if root.results.length == 0: Rectangle {
                    vertical-stretch: 1;
                    Text {
                        text: "Click 'Run Sensitivity Campaign' to test how environment perturbations affect the active repository's build artifacts.";
                        color: Theme.text-muted;
                        font-size: 12px;
                        wrap: word-wrap;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                }

                if root.results.length > 0: ListView {
                    vertical-stretch: 1;
                    for r in root.results: Rectangle {
                        height: 68px;
                        background: Theme.bg-elevated;
                        border-radius: Theme.radius-sm;
                        border-width: 1px;
                        border-color: Theme.border-subtle;

                        VerticalLayout {
                            padding: 10px;
                            spacing: 4px;
                            HorizontalLayout {
                                spacing: 8px;
                                Text { text: r.param_name; color: Theme.text-primary; font-size: 12px; font-weight: 700; horizontal-stretch: 1; }
                                StatusBadge { text: r.hash_changed ? "DRIFT TRIGGERED" : "INVARIANT"; kind: r.hash_changed ? "warning" : "success"; }
                                StatusBadge { text: r.epistemic_status; kind: r.epistemic_status == "EXPERIMENTALLY_VALIDATED" ? "success" : "info"; }
                            }
                            Text {
                                text: "Impact: " + r.causal_impact + "  (" + r.baseline_verdict + " -> " + r.perturbed_verdict + ")";
                                color: Theme.text-secondary;
                                font-size: 11px;
                                overflow: elide;
                            }
                        }
                    }
                }
            }
        }
    }
}
