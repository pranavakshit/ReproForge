import { ListView } from "std-widgets.slint";
import { Theme } from "../theme.slint";
import { MetricCard } from "../components/metric_card.slint";
import { PanelCard } from "../components/panel_card.slint";
import { ProgressMeter } from "../components/progress_meter.slint";
import { StatusBadge } from "../components/status_badge.slint";

export struct RecentBuildItem {
    build_id: string,
    repo: string,
    revision: string,
    backend: string,
    status: string,
    verdict: string,
}

export component OverviewView inherits Rectangle {
    in property <string> total_builds: "0";
    in property <string> total_comparisons: "0";
    in property <string> bit_for_bit_rate: "0.0%";
    in property <string> normalized_rate: "0.0%";
    in property <string> unresolved_count: "0";
    in property <float> cri_bit_ratio: 0.0;
    in property <float> cri_norm_ratio: 0.0;
    in property <float> cri_drift_ratio: 0.0;

    in property <string> host_os: "—";
    in property <string> host_arch: "—";
    in property <string> detected_toolchains: "Probing...";
    in property <string> docker_cli_version: "Probing...";
    in property <string> database_path: "data/reproforge.db";
    in property <[RecentBuildItem]> recent_builds: [];

    callback inspect_build_requested(int);

    background: Theme.bg-canvas;

    VerticalLayout {
        padding: 20px;
        spacing: 16px;

        // Top KPI Metric Grid
        HorizontalLayout {
            spacing: 14px;

            MetricCard {
                horizontal-stretch: 1;
                label: "TOTAL BUILDS";
                value: root.total_builds;
                subtitle: root.total_comparisons + " pairwise comparisons";
                accent_color: Theme.accent-primary;
            }
            MetricCard {
                horizontal-stretch: 1;
                label: "BIT-FOR-BIT MATCH";
                value: root.bit_for_bit_rate;
                subtitle: "Strict binary equivalence";
                accent_color: Theme.status-success;
            }
            MetricCard {
                horizontal-stretch: 1;
                label: "NORMALIZED MATCH";
                value: root.normalized_rate;
                subtitle: "Equivalent post-canonicalization";
                accent_color: Theme.accent-cyan;
            }
            MetricCard {
                horizontal-stretch: 1;
                label: "DRIFT FINDINGS";
                value: root.unresolved_count;
                subtitle: "Open root-cause variances";
                accent_color: Theme.status-warning;
            }
        }

        // Middle Two-Column Bento Grid
        HorizontalLayout {
            spacing: 16px;

            PanelCard {
                horizontal-stretch: 3;
                title: "Reproducibility Verdict Distribution";
                subtitle: "Aggregated across verified artifact comparisons";

                ProgressMeter {
                    label: "Exact Bit-for-Bit";
                    ratio: root.cri_bit_ratio;
                    value-text: root.bit_for_bit_rate;
                    fill-color: Theme.status-success;
                }
                ProgressMeter {
                    label: "Normalized Equivalent";
                    ratio: root.cri_norm_ratio;
                    value-text: root.normalized_rate;
                    fill-color: Theme.accent-cyan;
                }
                ProgressMeter {
                    label: "Content Divergent / Drift";
                    ratio: root.cri_drift_ratio;
                    fill-color: Theme.status-warning;
                }
            }

            PanelCard {
                horizontal-stretch: 2;
                title: "Execution Environment Probe";
                subtitle: "Local sandbox & container isolation readiness";

                GridLayout {
                    spacing: 8px;
                    Row {
                        Text { text: "Platform"; color: Theme.text-muted; font-size: 11.5px; }
                        Text {
                            text: root.host_os + " (" + root.host_arch + ")";
                            color: Theme.text-primary;
                            font-size: 11.5px;
                            font-weight: 600;
                            overflow: elide;
                        }
                    }
                    Row {
                        Text { text: "Toolchains"; color: Theme.text-muted; font-size: 11.5px; }
                        Text {
                            text: root.detected_toolchains;
                            color: Theme.text-code;
                            font-size: 11.5px;
                            wrap: word-wrap;
                        }
                    }
                    Row {
                        Text { text: "Container"; color: Theme.text-muted; font-size: 11.5px; }
                        Text {
                            text: root.docker_cli_version;
                            color: Theme.accent-cyan;
                            font-size: 11.5px;
                            font-weight: 600;
                            overflow: elide;
                        }
                    }
                    Row {
                        Text { text: "Database"; color: Theme.text-muted; font-size: 11.5px; }
                        Text {
                            text: root.database_path;
                            color: Theme.text-secondary;
                            font-size: 11px;
                            overflow: elide;
                        }
                    }
                }
            }
        }

        // Bottom Virtualized Recent Builds Table
        PanelCard {
            vertical-stretch: 1;
            title: "Recent Build Executions";
            subtitle: "Click any execution record to inspect artifacts and streaming logs";

            // Table Header Row
            Rectangle {
                height: 28px;
                background: Theme.bg-elevated;
                border-radius: Theme.radius-xs;

                HorizontalLayout {
                    padding-left: 12px;
                    padding-right: 12px;
                    spacing: 10px;
                    Text { text: "BUILD ID"; width: 125px; color: Theme.text-muted; font-size: 10.5px; font-weight: 700; vertical-alignment: center; }
                    Text { text: "REPOSITORY"; horizontal-stretch: 2; color: Theme.text-muted; font-size: 10.5px; font-weight: 700; vertical-alignment: center; }
                    Text { text: "REVISION"; width: 90px; color: Theme.text-muted; font-size: 10.5px; font-weight: 700; vertical-alignment: center; }
                    Text { text: "BACKEND"; width: 95px; color: Theme.text-muted; font-size: 10.5px; font-weight: 700; vertical-alignment: center; }
                    Text { text: "VERDICT"; width: 150px; color: Theme.text-muted; font-size: 10.5px; font-weight: 700; vertical-alignment: center; }
                    Text { text: "STATUS"; width: 85px; color: Theme.text-muted; font-size: 10.5px; font-weight: 700; vertical-alignment: center; horizontal-alignment: right; }
                }
            }

            if root.recent_builds.length == 0: Rectangle {
                vertical-stretch: 1;
                Text {
                    text: "No recent builds recorded yet. Switch to Repositories or Builds to trigger one.";
                    color: Theme.text-muted;
                    font-size: 12px;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
            }

            if root.recent_builds.length > 0: ListView {
                vertical-stretch: 1;
                for row[idx] in root.recent_builds: Rectangle {
                    height: 38px;
                    background: r-ta.has-hover ? Theme.bg-hover : (Math.mod(idx, 2) == 0 ? transparent : #0E1524);
                    border-radius: Theme.radius-xs;

                    HorizontalLayout {
                        padding-left: 12px;
                        padding-right: 12px;
                        spacing: 10px;

                        Text {
                            text: row.build_id;
                            width: 125px;
                            color: Theme.text-code;
                            font-size: 11.5px;
                            font-weight: 600;
                            vertical-alignment: center;
                            overflow: elide;
                        }
                        Text {
                            text: row.repo;
                            horizontal-stretch: 2;
                            color: Theme.text-primary;
                            font-size: 12px;
                            font-weight: 600;
                            vertical-alignment: center;
                            overflow: elide;
                        }
                        Text {
                            text: row.revision;
                            width: 90px;
                            color: Theme.text-secondary;
                            font-size: 11.5px;
                            vertical-alignment: center;
                            overflow: elide;
                        }
                        Text {
                            text: row.backend;
                            width: 95px;
                            color: Theme.text-secondary;
                            font-size: 11.5px;
                            vertical-alignment: center;
                        }
                        VerticalLayout {
                            width: 150px;
                            alignment: center;
                            StatusBadge {
                                text: row.verdict;
                                kind:
                                    row.verdict == "BIT_FOR_BIT" || row.verdict == "REPRODUCIBLE" ? "success" :
                                    row.verdict == "NORMALIZED" || row.verdict == "EQUIVALENT" ? "info" :
                                    row.verdict == "DRIFT" || row.verdict == "DIVERGENT" || row.verdict == "NON_REPRODUCIBLE" ? "warning" :
                                    "neutral";
                            }
                        }
                        Text {
                            text: row.status;
                            width: 85px;
                            color: row.status == "succeeded" || row.status == "completed" ? Theme.status-success : Theme.text-secondary;
                            font-size: 11.5px;
                            font-weight: 600;
                            vertical-alignment: center;
                            horizontal-alignment: right;
                        }
                    }

                    r-ta := TouchArea {
                        mouse-cursor: pointer;
                        clicked => { root.inspect_build_requested(idx); }
                    }
                }
            }
        }
    }
}
