import { ListView } from "std-widgets.slint";
import { Theme } from "../theme.slint";
import { ActionButton } from "../components/action_button.slint";
import { PanelCard } from "../components/panel_card.slint";
import { StatusBadge } from "../components/status_badge.slint";
import { IconPlay, IconStop } from "../components/icons.slint";

export struct BuildRowData {
    build_id: string,
    repo: string,
    commit: string,
    backend: string,
    status: string,
    verdict: string,
    hash_short: string,
}

export component BuildsView inherits Rectangle {
    in property <[BuildRowData]> builds: [];
    in-out property <int> selected_build_idx: 0;
    in property <string> selected_build_log: "";
    in property <string> selected_hash: "";
    in property <string> selected_artifact_count: "0 artifacts";
    in-out property <string> selected_backend_type: "local";
    in property <bool> docker_available: false;
    in property <int> active_build_count: 0;

    callback build_row_clicked(int);
    callback trigger_build_requested();
    callback verify_pair_requested();
    callback compare_latest_requested();
    callback cancel_build_requested();
    callback backend_type_selected(string);

    background: Theme.bg-canvas;

    VerticalLayout {
        padding: 20px;
        spacing: 14px;

        // Top Build Orchestration Control Bar
        PanelCard {
            inner-padding: 12px;
            inner-spacing: 8px;

            HorizontalLayout {
                alignment: space-between;
                spacing: 12px;

                HorizontalLayout {
                    spacing: 10px;

                    Text {
                        text: "Isolation Mode:";
                        color: Theme.text-secondary;
                        font-size: 12px;
                        font-weight: 600;
                        vertical-alignment: center;
                    }

                    // Docker Backend Option
                    Rectangle {
                        height: 30px;
                        border-radius: Theme.radius-sm;
                        background: root.selected_backend_type == "docker" ? Theme.accent-primary-soft : Theme.bg-elevated;
                        border-width: 1px;
                        border-color: root.selected_backend_type == "docker" ? Theme.accent-primary : Theme.border-muted;

                        HorizontalLayout {
                            padding-left: 11px;
                            padding-right: 11px;
                            Text {
                                text: root.docker_available ? "Docker Container (Isolated)" : "Docker Container (Unavailable)";
                                color: !root.docker_available ? Theme.text-muted : (root.selected_backend_type == "docker" ? #93C5FD : Theme.text-secondary);
                                font-size: 11.5px;
                                font-weight: 600;
                                vertical-alignment: center;
                            }
                        }
                        TouchArea {
                            enabled: root.docker_available;
                            mouse-cursor: root.docker_available ? pointer : default;
                            clicked => {
                                root.selected_backend_type = "docker";
                                root.backend_type_selected("docker");
                            }
                        }
                    }

                    // Local Sandbox Option
                    Rectangle {
                        height: 30px;
                        border-radius: Theme.radius-sm;
                        background: root.selected_backend_type == "local" ? Theme.status-warning-soft : Theme.bg-elevated;
                        border-width: 1px;
                        border-color: root.selected_backend_type == "local" ? Theme.status-warning : Theme.border-muted;

                        HorizontalLayout {
                            padding-left: 11px;
                            padding-right: 11px;
                            Text {
                                text: "Local Host Sandbox";
                                color: root.selected_backend_type == "local" ? #FCD34D : Theme.text-secondary;
                                font-size: 11.5px;
                                font-weight: 600;
                                vertical-alignment: center;
                            }
                        }
                        TouchArea {
                            mouse-cursor: pointer;
                            clicked => {
                                root.selected_backend_type = "local";
                                root.backend_type_selected("local");
                            }
                        }
                    }
                }

                HorizontalLayout {
                    spacing: 8px;
                    ActionButton {
                        label: root.active_build_count > 0 ? ("Running (" + root.active_build_count + ")") : "Verify Reproducibility (2x + Compare)";
                        variant: "primary";
                        btn-height: 32px;
                        clicked => { root.verify_pair_requested(); }
                        IconPlay { icon-size: 11px; icon-color: #FFFFFF; }
                    }
                    ActionButton {
                        label: "Single Build";
                        variant: "secondary";
                        btn-height: 32px;
                        clicked => { root.trigger_build_requested(); }
                    }
                    ActionButton {
                        label: "Compare Latest 2";
                        variant: "secondary";
                        btn-height: 32px;
                        clicked => { root.compare_latest_requested(); }
                    }
                    ActionButton {
                        label: "Abort";
                        variant: "danger";
                        btn-height: 32px;
                        disabled: root.active_build_count == 0;
                        clicked => { root.cancel_build_requested(); }
                        IconStop { icon-size: 11px; icon-color: root.active_build_count == 0 ? Theme.text-muted : #FCA5A5; }
                    }
                }
            }

            if root.selected_backend_type == "local": Text {
                text: "Host sandbox uses clean exported git trees and allowlisted environment variables; prefer Docker isolation when available.";
                color: Theme.text-muted;
                font-size: 10.5px;
            }
        }

        // Main Split: Build List + Streaming Console
        HorizontalLayout {
            vertical-stretch: 1;
            spacing: 16px;

            // Left Build Execution List
            PanelCard {
                horizontal-stretch: 2;
                title: "Execution History (" + root.builds.length + ")";
                subtitle: "Click a build to load full SHA-256 fingerprint & execution logs";

                if root.builds.length == 0: Rectangle {
                    vertical-stretch: 1;
                    Text {
                        text: "No builds found. Select a tracked repository and click Trigger Verification Build.";
                        color: Theme.text-muted;
                        font-size: 12px;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                        wrap: word-wrap;
                    }
                }

                if root.builds.length > 0: ListView {
                    vertical-stretch: 1;
                    for b[idx] in root.builds: Rectangle {
                        height: 62px;
                        border-radius: Theme.radius-sm;
                        background: idx == root.selected_build_idx ? Theme.accent-primary-soft : (b-ta.has-hover ? Theme.bg-hover : Theme.bg-elevated);
                        border-width: 1px;
                        border-color: idx == root.selected_build_idx ? Theme.accent-primary : Theme.border-subtle;

                        VerticalLayout {
                            padding: 9px;
                            spacing: 4px;

                            HorizontalLayout {
                                spacing: 8px;
                                Text {
                                    text: b.build_id;
                                    color: Theme.text-code;
                                    font-size: 12px;
                                    font-weight: 700;
                                    vertical-alignment: center;
                                }
                                Text {
                                    text: b.repo + " • " + b.commit;
                                    color: Theme.text-primary;
                                    font-size: 12px;
                                    horizontal-stretch: 1;
                                    overflow: elide;
                                    vertical-alignment: center;
                                }
                                StatusBadge {
                                    text: b.status;
                                    kind:
                                        b.status == "succeeded" || b.status == "completed" ? "success" :
                                        b.status == "running" || b.status == "pending" ? "info" :
                                        b.status == "failed" || b.status == "cancelled" ? "danger" :
                                        "neutral";
                                }
                            }

                            HorizontalLayout {
                                spacing: 10px;
                                Text {
                                    text: "Backend: " + b.backend;
                                    color: Theme.text-muted;
                                    font-size: 10.5px;
                                }
                                Text {
                                    text: b.hash_short;
                                    color: Theme.accent-cyan;
                                    font-size: 10.5px;
                                    horizontal-stretch: 1;
                                    overflow: elide;
                                    horizontal-alignment: right;
                                }
                            }
                        }

                        b-ta := TouchArea {
                            mouse-cursor: pointer;
                            clicked => {
                                root.selected_build_idx = idx;
                                root.build_row_clicked(idx);
                            }
                        }
                    }
                }
            }

            // Right Artifact Digest & Live Log Output
            PanelCard {
                horizontal-stretch: 3;
                title: "Artifact Digest & Execution Console";
                subtitle: root.selected_artifact_count;

                Rectangle {
                    height: 44px;
                    background: Theme.bg-input;
                    border-radius: Theme.radius-sm;
                    border-width: 1px;
                    border-color: Theme.border-subtle;

                    VerticalLayout {
                        padding-left: 12px;
                        padding-right: 12px;
                        alignment: center;
                        Text {
                            text: root.selected_hash;
                            color: Theme.accent-cyan;
                            font-size: 11.5px;
                            font-weight: 600;
                            overflow: elide;
                        }
                    }
                }

                Rectangle {
                    vertical-stretch: 1;
                    background: Theme.bg-deep;
                    border-radius: Theme.radius-sm;
                    border-width: 1px;
                    border-color: Theme.border-subtle;
                    clip: true;

                    Flickable {
                        content-height: log-text.preferred-height + 24px;
                        VerticalLayout {
                            padding: 12px;
                            log-text := Text {
                                text: root.selected_build_log != "" ? root.selected_build_log : "Select a build execution row to inspect persisted logs or trigger a build to stream live output.";
                                color: root.selected_build_log != "" ? Theme.text-code : Theme.text-muted;
                                font-size: 11.5px;
                                wrap: word-wrap;
                            }
                        }
                    }
                }
            }
        }
    }
}
