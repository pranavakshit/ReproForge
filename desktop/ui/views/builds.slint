import { Theme } from "../theme.slint";
import { ListView } from "std-widgets.slint";
import { StatusBadge } from "../components/status_badge.slint";

export struct BuildRowData {
    build_id: string,
    commit_sha: string,
    backend: string,
    status: string,
    verdict: string,
    duration: string,
}

export component BuildsView inherits Rectangle {
    in property <[BuildRowData]> build_rows: [];
    in property <int> total_count: 200;
    in property <int> filtered_count: 200;
    in property <string> selected_build_id: "";
    in property <string> selected_commit_sha: "";
    in property <string> selected_backend: "";
    in property <string> selected_verdict: "";
    in property <string> selected_hash: "";

    in-out property <string> search_query: "";
    in-out property <int> verdict_filter: 0; // 0: All, 1: Exact, 2: Norm, 3: Inconclusive, 4: Drift

    callback search_changed(string);
    callback verdict_filter_changed(int);
    callback row_selected(int);

    background: Theme.bg_primary;

    VerticalLayout {
        padding: 20px;
        spacing: 14px;
        alignment: start;

        // View Header
        HorizontalLayout {
            alignment: space-between;
            HorizontalLayout {
                spacing: 10px;
                Text {
                    text: "Build Executions & Reproducibility Ledger";
                    font-size: 18px;
                    font-weight: 700;
                    color: Theme.text_primary;
                    vertical-alignment: center;
                }
                Rectangle {
                    height: 20px;
                    border-radius: Theme.radius_sm;
                    background: Theme.bg_card;
                    border-width: 1px;
                    border-color: Theme.border_light;
                    HorizontalLayout {
                        padding-left: 6px; padding-right: 6px; alignment: center;
                        Text { text: "Mock Telemetry"; font-size: 10px; font-weight: 600; color: Theme.accent_cyan; vertical-alignment: center; }
                    }
                }
            }
            Text {
                text: "Showing " + root.filtered_count + " of " + root.total_count + " builds";
                font-size: 11px;
                color: Theme.text_dim;
                vertical-alignment: center;
            }
        }

        // Search & Filter Toolbar
        Rectangle {
            height: 48px;
            background: Theme.bg_secondary;
            border-radius: Theme.radius_md;
            border-width: 1px;
            border-color: Theme.border_subtle;

            HorizontalLayout {
                padding-left: 12px;
                padding-right: 12px;
                spacing: 14px;
                alignment: space-between;

                // Search Input Box
                Rectangle {
                    width: 280px;
                    height: 32px;
                    background: Theme.bg_card;
                    border-radius: Theme.radius_sm;
                    border-width: 1px;
                    border-color: Theme.border_light;

                    HorizontalLayout {
                        padding-left: 10px; padding-right: 10px;
                        Text { text: "🔍"; font-size: 11px; vertical-alignment: center; color: Theme.text_dim; }
                        TextInput {
                            text <=> root.search_query;
                            font-size: 12px;
                            color: Theme.text_primary;
                            vertical-alignment: center;
                            edited => { root.search_changed(self.text); }
                        }
                    }
                }

                // Filter Pills
                HorizontalLayout {
                    spacing: 8px;
                    alignment: end;

                    Text { text: "Filter:"; font-size: 11px; color: Theme.text_dim; vertical-alignment: center; }

                    Rectangle {
                        height: 26px; border-radius: Theme.radius_sm;
                        background: (root.verdict_filter == 0) ? Theme.accent_cyan : Theme.bg_card;
                        HorizontalLayout {
                            padding-left: 8px; padding-right: 8px; alignment: center;
                            Text {
                                text: "All"; font-size: 11px; font-weight: 600;
                                color: (root.verdict_filter == 0) ? #0b0f19 : Theme.text_secondary;
                                vertical-alignment: center;
                            }
                        }
                        TouchArea { clicked => { root.verdict_filter = 0; root.verdict_filter_changed(0); } }
                    }

                    Rectangle {
                        height: 26px; border-radius: Theme.radius_sm;
                        background: (root.verdict_filter == 1) ? Theme.status_exact : Theme.bg_card;
                        HorizontalLayout {
                            padding-left: 8px; padding-right: 8px; alignment: center;
                            Text {
                                text: "Exact"; font-size: 11px; font-weight: 600;
                                color: (root.verdict_filter == 1) ? #0b0f19 : Theme.status_exact;
                                vertical-alignment: center;
                            }
                        }
                        TouchArea { clicked => { root.verdict_filter = 1; root.verdict_filter_changed(1); } }
                    }

                    Rectangle {
                        height: 26px; border-radius: Theme.radius_sm;
                        background: (root.verdict_filter == 2) ? Theme.status_norm : Theme.bg_card;
                        HorizontalLayout {
                            padding-left: 8px; padding-right: 8px; alignment: center;
                            Text {
                                text: "Normalized"; font-size: 11px; font-weight: 600;
                                color: (root.verdict_filter == 2) ? #0b0f19 : Theme.status_norm;
                                vertical-alignment: center;
                            }
                        }
                        TouchArea { clicked => { root.verdict_filter = 2; root.verdict_filter_changed(2); } }
                    }

                    Rectangle {
                        height: 26px; border-radius: Theme.radius_sm;
                        background: (root.verdict_filter == 3) ? Theme.status_inconclusive : Theme.bg_card;
                        HorizontalLayout {
                            padding-left: 8px; padding-right: 8px; alignment: center;
                            Text {
                                text: "Inconclusive"; font-size: 11px; font-weight: 600;
                                color: (root.verdict_filter == 3) ? #0b0f19 : Theme.status_inconclusive;
                                vertical-alignment: center;
                            }
                        }
                        TouchArea { clicked => { root.verdict_filter = 3; root.verdict_filter_changed(3); } }
                    }
                }
            }
        }

        // Table Container (Virtualized ListView)
        Rectangle {
            height: 320px;
            background: Theme.bg_secondary;
            border-radius: Theme.radius_md;
            border-width: 1px;
            border-color: Theme.border_subtle;

            VerticalLayout {
                padding: 10px;
                spacing: 6px;

                // Table Header
                Rectangle {
                    height: 30px;
                    background: Theme.bg_elevated;
                    border-radius: Theme.radius_sm;

                    HorizontalLayout {
                        padding-left: 12px; padding-right: 12px;
                        Text { width: 140px; text: "BUILD ID"; font-size: 11px; font-weight: 600; color: Theme.text_muted; vertical-alignment: center; }
                        Text { width: 110px; text: "COMMIT"; font-size: 11px; font-weight: 600; color: Theme.text_muted; vertical-alignment: center; }
                        Text { width: 90px; text: "BACKEND"; font-size: 11px; font-weight: 600; color: Theme.text_muted; vertical-alignment: center; }
                        Text { width: 90px; text: "STATUS"; font-size: 11px; font-weight: 600; color: Theme.text_muted; vertical-alignment: center; }
                        Text { width: 220px; text: "CATEGORICAL VERDICT"; font-size: 11px; font-weight: 600; color: Theme.text_muted; vertical-alignment: center; }
                        Text { text: "DURATION"; font-size: 11px; font-weight: 600; color: Theme.text_muted; vertical-alignment: center; }
                    }
                }

                // Virtualized Rows
                ListView {
                    for row[idx] in root.build_rows : Rectangle {
                        height: 36px;
                        background: (root.selected_build_id == row.build_id) ? Theme.bg_active :
                                    (row_touch.has_hover ? Theme.bg_hover : Theme.bg_card);
                        border-width: 1px;
                        border-color: (root.selected_build_id == row.build_id) ? Theme.border_accent : Theme.border_subtle;

                        row_touch := TouchArea {
                            clicked => { root.row_selected(idx); }
                        }

                        HorizontalLayout {
                            padding-left: 12px; padding-right: 12px;
                            Text { width: 140px; text: row.build_id; font-size: 12px; font-weight: 600; color: Theme.text_primary; vertical-alignment: center; }
                            Text { width: 110px; text: row.commit_sha; font-size: 11px; color: Theme.text_secondary; vertical-alignment: center; }
                            Text { width: 90px; text: row.backend; font-size: 11px; color: Theme.text_muted; vertical-alignment: center; }
                            Text {
                                width: 90px;
                                text: row.status;
                                font-size: 11px;
                                font-weight: 600;
                                color: (row.status == "completed") ? Theme.status_exact : Theme.status_fail;
                                vertical-alignment: center;
                            }
                            HorizontalLayout {
                                width: 220px;
                                alignment: start;
                                StatusBadge {
                                    text: row.verdict;
                                    variant: (row.verdict == "bit_for_bit_reproducible") ? "exact" :
                                             (row.verdict == "normalized_reproducible") ? "norm" :
                                             (row.verdict == "inconclusive") ? "inconclusive" : "warn";
                                }
                            }
                            Text { text: row.duration; font-size: 11px; color: Theme.text_dim; vertical-alignment: center; }
                        }
                    }
                }
            }
        }

        // Build Inspection Detail Drawer (Bottom Card)
        Rectangle {
            height: 90px;
            background: Theme.bg_secondary;
            border-radius: Theme.radius_md;
            border-width: 1px;
            border-color: Theme.border_subtle;

            HorizontalLayout {
                padding: 12px;
                spacing: 24px;
                alignment: space-between;

                VerticalLayout {
                    spacing: 4px;
                    Text { text: "SELECTED BUILD"; font-size: 10px; font-weight: 600; color: Theme.text_dim; }
                    Text { text: root.selected_build_id != "" ? root.selected_build_id : "bld-rec-00001"; font-size: 14px; font-weight: 700; color: Theme.accent_cyan; }
                    Text { text: "Commit: " + (root.selected_commit_sha != "" ? root.selected_commit_sha : "a1b2c3d4f4"); font-size: 11px; color: Theme.text_secondary; }
                }

                VerticalLayout {
                    spacing: 4px;
                    Text { text: "SANDBOX ISOLATION"; font-size: 10px; font-weight: 600; color: Theme.text_dim; }
                    Text { text: "Backend: " + (root.selected_backend != "" ? root.selected_backend : "docker"); font-size: 12px; font-weight: 600; color: Theme.text_primary; }
                    Text { text: "Isolation: Process/Network Gated"; font-size: 11px; color: Theme.status_exact; }
                }

                VerticalLayout {
                    spacing: 4px;
                    Text { text: "STREAMING ARTIFACT HASH"; font-size: 10px; font-weight: 600; color: Theme.text_dim; }
                    Text { text: root.selected_hash != "" ? root.selected_hash : "e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855"; font-size: 11px; color: Theme.text_secondary; overflow: elide; width: 340px; }
                    Text { text: "Dual-Hasher: BLAKE2b + SHA-256 Verified"; font-size: 10px; color: Theme.text_dim; }
                }
            }
        }
    }
}
