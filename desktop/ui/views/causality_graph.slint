import { Theme } from "../theme.slint";
import { StatusBadge } from "../components/status_badge.slint";

export struct GraphNodeItem {
    id: string,
    label: string,
    node_type: string, // "comparison", "build", "revision", "fingerprint", "diff", "rule", "remediation"
    status: string,
    detail: string,
}

export struct GraphEdgeItem {
    source: string,
    target: string,
    relation: string,
    epistemic_status: string, // "OBSERVED", "INFERRED", "HYPOTHESIS", "EXPERIMENTALLY_VALIDATED"
    confidence: string,
}

export component CausalityGraphView inherits Rectangle {
    in property <string> comparison_id: "cmp-latest";
    in property <[GraphNodeItem]> nodes: [];
    in property <[GraphEdgeItem]> edges: [];
    in property <int> selected_node_index: 0;
    in property <string> dot_source: "";
    callback node_selected(int);
    callback refresh_graph_requested();
    callback export_dot_requested();

    background: Theme.bg_primary;

    VerticalLayout {
        padding: 20px;
        spacing: 16px;

        // View Header
        HorizontalLayout {
            alignment: space-between;
            VerticalLayout {
                spacing: 4px;
                HorizontalLayout {
                    spacing: 10px;
                    Text {
                        text: "Build Drift Causality Graph";
                        font-size: 18px;
                        font-weight: 700;
                        color: Theme.text_primary;
                        vertical-alignment: center;
                    }
                    Rectangle {
                        height: 20px;
                        border-radius: Theme.radius_sm;
                        background: Theme.status_inconclusive_bg;
                        border-width: 1px;
                        border-color: Theme.status_inconclusive_border;
                        HorizontalLayout {
                            padding-left: 8px; padding-right: 8px; alignment: center;
                            Text {
                                text: "Strict Epistemic DAG";
                                font-size: 10px;
                                font-weight: 600;
                                color: Theme.status_inconclusive;
                                vertical-alignment: center;
                            }
                        }
                    }
                }
                Text {
                    text: "Evidence-backed DAG tracing root causes from revisions to artifacts, diagnostic rules, and remediations.";
                    font-size: 12px;
                    color: Theme.text_dim;
                }
            }

            HorizontalLayout {
                spacing: 10px;
                alignment: end;
                Rectangle {
                    width: 120px;
                    height: 32px;
                    background: Theme.bg_card;
                    border-radius: Theme.radius_md;
                    border-width: 1px;
                    border-color: Theme.border_subtle;
                    refresh_touch := TouchArea { clicked => { root.refresh_graph_requested(); } }
                    HorizontalLayout {
                        alignment: center;
                        spacing: 6px;
                        Text { text: "⟳ Refresh DAG"; font-size: 11px; font-weight: 600; color: Theme.text_primary; vertical-alignment: center; }
                    }
                }
            }
        }

        // Epistemic Status Banner
        Rectangle {
            height: 40px;
            background: Theme.bg_secondary;
            border-radius: Theme.radius_md;
            border-width: 1px;
            border-color: Theme.border_subtle;

            HorizontalLayout {
                padding-left: 14px;
                padding-right: 14px;
                spacing: 20px;
                alignment: start;

                Text { text: "EPISTEMIC TIERS:"; font-size: 10px; font-weight: 700; color: Theme.text_dim; vertical-alignment: center; }

                HorizontalLayout {
                    spacing: 6px;
                    VerticalLayout {
                        alignment: center;
                        Rectangle { width: 8px; height: 8px; border-radius: 4px; background: Theme.status_exact; }
                    }
                    Text { text: "OBSERVED (Direct bit/byte measurement)"; font-size: 11px; color: Theme.text_secondary; vertical-alignment: center; }
                }

                HorizontalLayout {
                    spacing: 6px;
                    VerticalLayout {
                        alignment: center;
                        Rectangle { width: 8px; height: 8px; border-radius: 4px; background: Theme.status_norm; }
                    }
                    Text { text: "INFERRED (Deterministic rule engine)"; font-size: 11px; color: Theme.text_secondary; vertical-alignment: center; }
                }

                HorizontalLayout {
                    spacing: 6px;
                    VerticalLayout {
                        alignment: center;
                        Rectangle { width: 8px; height: 8px; border-radius: 4px; background: Theme.status_warn; }
                    }
                    Text { text: "HYPOTHESIS (Plausible, requires intervention)"; font-size: 11px; color: Theme.text_secondary; vertical-alignment: center; }
                }

                HorizontalLayout {
                    spacing: 6px;
                    VerticalLayout {
                        alignment: center;
                        Rectangle { width: 8px; height: 8px; border-radius: 4px; background: Theme.status_inconclusive; }
                    }
                    Text { text: "EXPERIMENTALLY_VALIDATED"; font-size: 11px; font-weight: 600; color: Theme.status_inconclusive; vertical-alignment: center; }
                }
            }
        }

        // Main Split Canvas: Left DAG Node Flow, Right Selected Inspector
        HorizontalLayout {
            spacing: 16px;

            // Left DAG Nodes Flow
            Rectangle {
                horizontal-stretch: 3;
                background: Theme.bg_secondary;
                border-radius: Theme.radius_md;
                border-width: 1px;
                border-color: Theme.border_subtle;

                VerticalLayout {
                    padding: 14px;
                    spacing: 10px;

                    HorizontalLayout {
                        alignment: space-between;
                        Text { text: "Causality DAG Node Hierarchy"; font-size: 13px; font-weight: 600; color: Theme.text_primary; }
                        Text { text: "Click any node to inspect causality edges"; font-size: 11px; color: Theme.text_dim; }
                    }

                    // Node list / Flow
                    Flickable {
                        height: 480px;
                        content-height: (root.nodes.length * 64px) + 20px;

                        VerticalLayout {
                            spacing: 8px;
                            padding-top: 4px;

                            for node[idx] in root.nodes : Rectangle {
                                height: 56px;
                                border-radius: Theme.radius_md;
                                background: (root.selected_node_index == idx) ? Theme.bg_active :
                                            (item_touch.has_hover ? Theme.bg_hover : Theme.bg_card);
                                border-width: 1px;
                                border-color: (root.selected_node_index == idx) ? Theme.border_accent : Theme.border_subtle;

                                item_touch := TouchArea {
                                    clicked => { root.node_selected(idx); }
                                }

                                HorizontalLayout {
                                    padding-left: 12px;
                                    padding-right: 12px;
                                    spacing: 12px;
                                    alignment: space-between;

                                    HorizontalLayout {
                                        spacing: 12px;
                                        // Type pill
                                        VerticalLayout {
                                            alignment: center;
                                            Rectangle {
                                                width: 90px;
                                                height: 26px;
                                                border-radius: Theme.radius_sm;
                                                background: (node.node_type == "revision") ? #1e1b4b :
                                                            (node.node_type == "build") ? #0c4a6e :
                                                            (node.node_type == "fingerprint") ? #14532d :
                                                            (node.node_type == "diff") ? #451a03 :
                                                            (node.node_type == "rule") ? #3b0764 : #312e81;
                                                border-width: 1px;
                                                border-color: (node.node_type == "revision") ? #4338ca :
                                                              (node.node_type == "build") ? Theme.border_accent :
                                                              (node.node_type == "fingerprint") ? Theme.status_exact :
                                                              (node.node_type == "diff") ? Theme.status_warn :
                                                              (node.node_type == "rule") ? Theme.status_inconclusive : #6366f1;
                                                HorizontalLayout {
                                                    alignment: center;
                                                    Text {
                                                        text: (node.node_type == "revision") ? "REVISION" :
                                                              (node.node_type == "build") ? "BUILD" :
                                                              (node.node_type == "fingerprint") ? "HOST ENV" :
                                                              (node.node_type == "diff") ? "DIFF" :
                                                              (node.node_type == "rule") ? "DIAGNOSIS" : "REMEDY";
                                                        font-size: 10px;
                                                        font-weight: 700;
                                                        color: Theme.text_primary;
                                                        vertical-alignment: center;
                                                    }
                                                }
                                            }
                                        }

                                        VerticalLayout {
                                            alignment: center;
                                            spacing: 2px;
                                            Text {
                                                text: node.label;
                                                font-size: 12px;
                                                font-weight: 600;
                                                color: Theme.text_primary;
                                                overflow: elide;
                                            }
                                            Text {
                                                text: node.detail;
                                                font-size: 11px;
                                                color: Theme.text_dim;
                                                overflow: elide;
                                            }
                                        }
                                    }

                                    HorizontalLayout {
                                        alignment: end;
                                        spacing: 8px;
                                        VerticalLayout {
                                            alignment: center;
                                            Rectangle {
                                                height: 22px;
                                                border-radius: Theme.radius_sm;
                                                background: Theme.bg_elevated;
                                                HorizontalLayout {
                                                    padding-left: 8px; padding-right: 8px;
                                                    Text { text: node.id; font-size: 10px; color: Theme.accent_cyan; vertical-alignment: center; }
                                                }
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }

            // Right Inspector & Causality Relational Edges
            Rectangle {
                horizontal-stretch: 2;
                background: Theme.bg_secondary;
                border-radius: Theme.radius_md;
                border-width: 1px;
                border-color: Theme.border_subtle;

                VerticalLayout {
                    padding: 14px;
                    spacing: 12px;

                    Text { text: "Causality Evidence Inspector"; font-size: 13px; font-weight: 600; color: Theme.text_primary; }

                    // Active Node Card
                    Rectangle {
                        background: Theme.bg_card;
                        border-radius: Theme.radius_md;
                        border-width: 1px;
                        border-color: Theme.border_accent;
                        padding: 12px;

                        VerticalLayout {
                            spacing: 8px;
                            HorizontalLayout {
                                alignment: space-between;
                                Text { text: "SELECTED NODE"; font-size: 10px; font-weight: 700; color: Theme.text_dim; }
                                StatusBadge { text: "Active in DAG"; variant: "norm"; }
                            }
                            Text {
                                text: (root.selected_node_index < root.nodes.length) ? root.nodes[root.selected_node_index].label : "No node selected";
                                font-size: 14px;
                                font-weight: 700;
                                color: Theme.text_primary;
                            }
                            Text {
                                text: (root.selected_node_index < root.nodes.length) ? ("Node ID: " + root.nodes[root.selected_node_index].id) : "";
                                font-size: 11px;
                                color: Theme.text_dim;
                            }
                        }
                    }

                    // Relational Edges List
                    Text { text: "Relational Edges & Evidence Provenance:"; font-size: 11px; font-weight: 600; color: Theme.text_muted; }

                    Flickable {
                        height: 220px;
                        content-height: (root.edges.length * 60px) + 20px;

                        VerticalLayout {
                            spacing: 6px;
                            for edge in root.edges : Rectangle {
                                height: 52px;
                                background: Theme.bg_card;
                                border-radius: Theme.radius_sm;
                                border-width: 1px;
                                border-color: (edge.epistemic_status == "EXPERIMENTALLY_VALIDATED") ? Theme.status_inconclusive_border :
                                              (edge.epistemic_status == "OBSERVED") ? Theme.status_exact_border :
                                              (edge.epistemic_status == "INFERRED") ? Theme.status_norm_border : Theme.status_warn_border;
                                padding: 6px;

                                VerticalLayout {
                                    spacing: 2px;
                                    HorizontalLayout {
                                        alignment: space-between;
                                        Text { text: edge.relation; font-size: 11px; font-weight: 700; color: Theme.accent_cyan; }
                                        StatusBadge {
                                            text: edge.epistemic_status;
                                            variant: (edge.epistemic_status == "OBSERVED") ? "exact" :
                                                     (edge.epistemic_status == "INFERRED") ? "norm" :
                                                     (edge.epistemic_status == "EXPERIMENTALLY_VALIDATED") ? "inconclusive" : "warn";
                                        }
                                    }
                                    Text {
                                        text: edge.source + " ──▶ " + edge.target;
                                        font-size: 10px;
                                        color: Theme.text_secondary;
                                        overflow: elide;
                                    }
                                }
                            }
                        }
                    }

                    // Graphviz DOT Export
                    Rectangle {
                        background: Theme.bg_elevated;
                        border-radius: Theme.radius_sm;
                        padding: 10px;

                        VerticalLayout {
                            spacing: 6px;
                            HorizontalLayout {
                                alignment: space-between;
                                Text { text: "Graphviz DOT Export Format"; font-size: 10px; font-weight: 600; color: Theme.text_dim; vertical-alignment: center; }
                                Rectangle {
                                    height: 24px;
                                    background: Theme.bg_card;
                                    border-radius: Theme.radius_sm;
                                    border-width: 1px;
                                    border-color: Theme.border_light;
                                    dot_touch := TouchArea { clicked => { root.export_dot_requested(); } }
                                    HorizontalLayout {
                                        padding-left: 8px; padding-right: 8px;
                                        Text { text: "📋 Copy DOT"; font-size: 10px; font-weight: 600; color: Theme.accent_cyan; vertical-alignment: center; }
                                    }
                                }
                            }
                            Text {
                                text: (root.dot_source != "") ? root.dot_source : "digraph BuildDriftCausalityGraph {\n  rankdir=\"LR\";\n  // nodes & evidence-backed edges\n}";
                                font-size: 10px;
                                color: Theme.text_muted;
                                overflow: elide;
                                max-height: 48px;
                            }
                        }
                    }
                }
            }
        }
    }
}
