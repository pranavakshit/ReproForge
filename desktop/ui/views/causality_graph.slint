import { ListView } from "std-widgets.slint";
import { Theme } from "../theme.slint";
import { ActionButton } from "../components/action_button.slint";
import { PanelCard } from "../components/panel_card.slint";
import { StatusBadge } from "../components/status_badge.slint";
import { IconRefresh, IconExport } from "../components/icons.slint";

export struct GraphNodeItem {
    id: string,
    node_type: string,
    label: string,
    subtitle: string,
    details_summary: string,
    epistemic_status: string,
    tier: int,
}

export struct GraphEdgeItem {
    source_id: string,
    target_id: string,
    source_label: string,
    target_label: string,
    direction: string,
    relation: string,
    confidence: string,
    epistemic_status: string,
    evidence: string,
}

component StageColumn inherits Rectangle {
    in property <string> stage-title;
    in property <int> target-tier;
    in property <[GraphNodeItem]> nodes: [];
    in property <int> selected-idx: -1;
    callback node-clicked(int);

    horizontal-stretch: 1;
    min-width: 170px;
    background: Theme.bg-elevated;
    border-radius: Theme.radius-sm;
    border-width: 1px;
    border-color: Theme.border-subtle;

    VerticalLayout {
        padding: 10px;
        spacing: 8px;

        Rectangle {
            height: 24px;
            background: Theme.bg-card;
            border-radius: Theme.radius-xs;
            Text {
                text: root.stage-title;
                color: Theme.text-secondary;
                font-size: 10.5px;
                font-weight: 700;
                letter-spacing: 0.4px;
                horizontal-alignment: center;
                vertical-alignment: center;
            }
        }

        ListView {
            vertical-stretch: 1;
            for node[idx] in root.nodes: VerticalLayout {
                if node.tier == root.target-tier: VerticalLayout {
                    padding-bottom: 6px;
                    Rectangle {
                        min-height: 58px;
                        border-radius: Theme.radius-xs;
                        background: idx == root.selected-idx ? Theme.accent-primary-soft : (n-ta.has-hover ? Theme.bg-hover : Theme.bg-card);
                        border-width: 1px;
                        border-color: idx == root.selected-idx ? Theme.accent-primary : (
                            node.epistemic_status == "EXPERIMENTALLY_VALIDATED" ? Theme.status-success :
                            node.epistemic_status == "OBSERVED" ? Theme.accent-cyan :
                            node.epistemic_status == "INFERRED" ? Theme.status-warning :
                            Theme.border-muted
                        );

                        VerticalLayout {
                            padding: 8px;
                            spacing: 3px;
                            Text {
                                text: node.node_type;
                                color: Theme.text-muted;
                                font-size: 9.5px;
                                font-weight: 700;
                            }
                            Text {
                                text: node.label;
                                color: Theme.text-primary;
                                font-size: 11.5px;
                                font-weight: 600;
                                overflow: elide;
                            }
                            if node.subtitle != "": Text {
                                text: node.subtitle;
                                color: Theme.text-secondary;
                                font-size: 10px;
                                overflow: elide;
                            }
                        }

                        n-ta := TouchArea {
                            mouse-cursor: pointer;
                            clicked => { root.node-clicked(idx); }
                        }
                    }
                }
            }
        }
    }
}

component StageArrow inherits VerticalLayout {
    width: 14px;
    alignment: center;
    Path {
        width: 12px;
        height: 12px;
        viewbox-x: 0;
        viewbox-y: 0;
        viewbox-width: 16;
        viewbox-height: 16;
        stroke: Theme.border-muted;
        stroke-width: 1.6px;
        fill: transparent;
        commands: "M 2 8 L 13 8 M 9 4 L 13 8 L 9 12";
    }
}

export component CausalityGraphView inherits Rectangle {
    in property <[GraphNodeItem]> nodes: [];
    in property <[GraphEdgeItem]> edges: [];
    in property <int> total_edge_count: 0;
    in-out property <int> selected_node_idx: -1;

    callback node_selected(int);
    callback clear_node_filter();
    callback refresh_graph_requested();
    callback export_dot_requested();

    background: Theme.bg-canvas;

    VerticalLayout {
        padding: 20px;
        spacing: 14px;

        // Header Toolbar & Epistemic Legend
        PanelCard {
            inner-padding: 12px;
            HorizontalLayout {
                alignment: space-between;
                spacing: 12px;

                HorizontalLayout {
                    spacing: 10px;
                    Text {
                        text: root.nodes.length + " nodes • " + root.total_edge_count + " causal edges";
                        color: Theme.text-primary;
                        font-size: 12.5px;
                        font-weight: 700;
                        vertical-alignment: center;
                    }
                    StatusBadge { text: "VALIDATED"; kind: "success"; }
                    StatusBadge { text: "OBSERVED"; kind: "info"; }
                    StatusBadge { text: "INFERRED"; kind: "warning"; }
                    StatusBadge { text: "HYPOTHESIS"; kind: "neutral"; }
                }

                HorizontalLayout {
                    spacing: 10px;
                    if root.selected_node_idx >= 0: ActionButton {
                        label: "Show All Edges";
                        variant: "ghost";
                        btn-height: 30px;
                        clicked => {
                            root.selected_node_idx = -1;
                            root.clear_node_filter();
                        }
                    }
                    ActionButton {
                        label: "Refresh DAG";
                        variant: "secondary";
                        btn-height: 30px;
                        clicked => { root.refresh_graph_requested(); }
                        IconRefresh { icon-size: 12px; icon-color: Theme.text-secondary; }
                    }
                    ActionButton {
                        label: "Export Graphviz (.dot)";
                        variant: "primary";
                        btn-height: 30px;
                        clicked => { root.export_dot_requested(); }
                        IconExport { icon-size: 12px; icon-color: #FFFFFF; }
                    }
                }
            }
        }

        // 5-Stage Layered Causal Pipeline
        PanelCard {
            vertical-stretch: 3;
            title: "Directed Acyclic Causality Flow";
            subtitle: "Click any entity node across causal stages to filter & inspect its incoming/outgoing provenance links";

            HorizontalLayout {
                vertical-stretch: 1;
                spacing: 6px;

                StageColumn { stage-title: "1. REVISION"; target-tier: 0; nodes: root.nodes; selected-idx: root.selected_node_idx; node-clicked(i) => { root.selected_node_idx = i; root.node_selected(i); } }
                StageArrow {}
                StageColumn { stage-title: "2. BUILDS"; target-tier: 1; nodes: root.nodes; selected-idx: root.selected_node_idx; node-clicked(i) => { root.selected_node_idx = i; root.node_selected(i); } }
                StageArrow {}
                StageColumn { stage-title: "3. ENVIRONMENT"; target-tier: 2; nodes: root.nodes; selected-idx: root.selected_node_idx; node-clicked(i) => { root.selected_node_idx = i; root.node_selected(i); } }
                StageArrow {}
                StageColumn { stage-title: "4. ARTIFACT DIFF"; target-tier: 3; nodes: root.nodes; selected-idx: root.selected_node_idx; node-clicked(i) => { root.selected_node_idx = i; root.node_selected(i); } }
                StageArrow {}
                StageColumn { stage-title: "5. RCA & FIX"; target-tier: 4; nodes: root.nodes; selected-idx: root.selected_node_idx; node-clicked(i) => { root.selected_node_idx = i; root.node_selected(i); } }
            }
        }

        // Bottom Enriched Causal Links & Selected Node Details Inspector
        PanelCard {
            vertical-stretch: 3;
            title: (root.selected_node_idx >= 0 && root.selected_node_idx < root.nodes.length)
                ? ("Causal Links for: " + root.nodes[root.selected_node_idx].label + " (" + root.edges.length + " connected)")
                : "All Evidence-Backed Causal Edges (" + root.edges.length + ")";
            subtitle: "Human-readable provenance chains showing exact node connections, confidence, and supporting evidence";

            if root.selected_node_idx >= 0 && root.selected_node_idx < root.nodes.length && root.nodes[root.selected_node_idx].details_summary != "": Rectangle {
                background: Theme.accent-primary-soft;
                border-radius: Theme.radius-xs;
                border-width: 1px;
                border-color: #264882;

                HorizontalLayout {
                    padding: 9px;
                    spacing: 10px;
                    StatusBadge { text: root.nodes[root.selected_node_idx].node_type; kind: "info"; }
                    Text {
                        text: root.nodes[root.selected_node_idx].details_summary;
                        color: #DBEAFE;
                        font-size: 11px;
                        horizontal-stretch: 1;
                        wrap: word-wrap;
                        vertical-alignment: center;
                    }
                    StatusBadge {
                        text: root.nodes[root.selected_node_idx].epistemic_status;
                        kind: root.nodes[root.selected_node_idx].epistemic_status == "EXPERIMENTALLY_VALIDATED" ? "success" : "info";
                    }
                }
            }

            if root.edges.length == 0: Rectangle {
                vertical-stretch: 1;
                Text {
                    text: root.selected_node_idx >= 0
                        ? "No direct causal edges attached to this node."
                        : "No causal edges generated yet. Trigger a build comparison to synthesize the DAG.";
                    color: Theme.text-muted;
                    font-size: 12px;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
            }

            if root.edges.length > 0: ListView {
                vertical-stretch: 1;
                for edge in root.edges: VerticalLayout {
                    padding-bottom: 6px;
                    Rectangle {
                        min-height: 58px;
                        background: Theme.bg-elevated;
                        border-radius: Theme.radius-xs;
                        border-width: 1px;
                        border-color: Theme.border-subtle;

                        VerticalLayout {
                            padding: 9px;
                            spacing: 4px;

                            HorizontalLayout {
                                spacing: 8px;
                                if edge.direction != "": StatusBadge {
                                    text: edge.direction;
                                    kind: edge.direction == "INCOMING" ? "info" : (edge.direction == "OUTGOING" ? "warning" : "neutral");
                                }
                                Text {
                                    text: edge.source_label != "" ? edge.source_label : edge.source_id;
                                    color: Theme.text-primary;
                                    font-size: 11.5px;
                                    font-weight: 600;
                                    horizontal-stretch: 1;
                                    overflow: elide;
                                    vertical-alignment: center;
                                }
                                Text {
                                    text: "-> [" + edge.relation + "] ->";
                                    color: Theme.accent-cyan;
                                    font-size: 10.5px;
                                    font-weight: 700;
                                    vertical-alignment: center;
                                }
                                Text {
                                    text: edge.target_label != "" ? edge.target_label : edge.target_id;
                                    color: Theme.text-primary;
                                    font-size: 11.5px;
                                    font-weight: 600;
                                    horizontal-stretch: 1;
                                    overflow: elide;
                                    vertical-alignment: center;
                                }
                                if edge.confidence != "": StatusBadge {
                                    text: edge.confidence + " CONF";
                                    kind: "neutral";
                                }
                                StatusBadge {
                                    text: edge.epistemic_status;
                                    kind: edge.epistemic_status == "EXPERIMENTALLY_VALIDATED" ? "success" : (edge.epistemic_status == "OBSERVED" ? "info" : "warning");
                                }
                            }

                            if edge.evidence != "": Text {
                                text: edge.evidence;
                                color: Theme.text-secondary;
                                font-size: 11px;
                                wrap: word-wrap;
                            }
                        }
                    }
                }
            }
        }
    }
}
