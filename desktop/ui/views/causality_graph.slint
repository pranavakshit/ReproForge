import { ListView } from "std-widgets.slint";
import { Theme } from "../theme.slint";
import { ActionButton } from "../components/action_button.slint";
import { PanelCard } from "../components/panel_card.slint";
import { StatusBadge } from "../components/status_badge.slint";
import { IconRefresh, IconExport } from "../components/icons.slint";

export struct GraphNodeItem {
    id: string,
    node_type: string,
    label: string,
    subtitle: string,
    epistemic_status: string,
    tier: int,
}

export struct GraphEdgeItem {
    source_id: string,
    target_id: string,
    relation: string,
    epistemic_status: string,
    evidence: string,
}

component StageColumn inherits Rectangle {
    in property <string> stage-title;
    in property <int> target-tier;
    in property <[GraphNodeItem]> nodes: [];
    in property <int> selected-idx: -1;
    callback node-clicked(int);

    horizontal-stretch: 1;
    min-width: 175px;
    background: Theme.bg-elevated;
    border-radius: Theme.radius-sm;
    border-width: 1px;
    border-color: Theme.border-subtle;

    VerticalLayout {
        padding: 10px;
        spacing: 8px;

        Rectangle {
            height: 24px;
            background: Theme.bg-card;
            border-radius: Theme.radius-xs;
            Text {
                text: root.stage-title;
                color: Theme.text-secondary;
                font-size: 10.5px;
                font-weight: 700;
                letter-spacing: 0.4px;
                horizontal-alignment: center;
                vertical-alignment: center;
            }
        }

        ListView {
            vertical-stretch: 1;
            for node[idx] in root.nodes: VerticalLayout {
                if node.tier == root.target-tier: VerticalLayout {
                    padding-bottom: 6px;
                    Rectangle {
                        min-height: 58px;
                        border-radius: Theme.radius-xs;
                        background: idx == root.selected-idx ? Theme.accent-primary-soft : (n-ta.has-hover ? Theme.bg-hover : Theme.bg-card);
                        border-width: 1px;
                        border-color: idx == root.selected-idx ? Theme.accent-primary : (
                            node.epistemic_status == "EXPERIMENTALLY_VALIDATED" ? Theme.status-success :
                            node.epistemic_status == "OBSERVED" ? Theme.accent-cyan :
                            node.epistemic_status == "INFERRED" ? Theme.status-warning :
                            Theme.border-muted
                        );

                        VerticalLayout {
                            padding: 8px;
                            spacing: 3px;
                            Text {
                                text: node.node_type;
                                color: Theme.text-muted;
                                font-size: 9.5px;
                                font-weight: 700;
                            }
                            Text {
                                text: node.label;
                                color: Theme.text-primary;
                                font-size: 11.5px;
                                font-weight: 600;
                                overflow: elide;
                            }
                            if node.subtitle != "": Text {
                                text: node.subtitle;
                                color: Theme.text-secondary;
                                font-size: 10px;
                                overflow: elide;
                            }
                        }

                        n-ta := TouchArea {
                            mouse-cursor: pointer;
                            clicked => { root.node-clicked(idx); }
                        }
                    }
                }
            }
        }
    }
}

component StageArrow inherits VerticalLayout {
    width: 16px;
    alignment: center;
    Path {
        width: 14px;
        height: 14px;
        viewbox-x: 0;
        viewbox-y: 0;
        viewbox-width: 16;
        viewbox-height: 16;
        stroke: Theme.border-muted;
        stroke-width: 1.6px;
        fill: transparent;
        commands: "M 2 8 L 13 8 M 9 4 L 13 8 L 9 12";
    }
}

export component CausalityGraphView inherits Rectangle {
    in property <[GraphNodeItem]> nodes: [];
    in property <[GraphEdgeItem]> edges: [];
    in-out property <int> selected_node_idx: -1;

    callback node_selected(int);
    callback refresh_graph_requested();
    callback export_dot_requested();

    background: Theme.bg-canvas;

    VerticalLayout {
        padding: 20px;
        spacing: 14px;

        // Header Toolbar & Epistemic Legend
        PanelCard {
            inner-padding: 12px;
            HorizontalLayout {
                alignment: space-between;
                spacing: 12px;

                HorizontalLayout {
                    spacing: 10px;
                    Text {
                        text: root.nodes.length + " nodes • " + root.edges.length + " causal edges";
                        color: Theme.text-primary;
                        font-size: 12.5px;
                        font-weight: 700;
                        vertical-alignment: center;
                    }
                    StatusBadge { text: "VALIDATED"; kind: "success"; }
                    StatusBadge { text: "OBSERVED"; kind: "info"; }
                    StatusBadge { text: "INFERRED"; kind: "warning"; }
                    StatusBadge { text: "HYPOTHESIS"; kind: "neutral"; }
                }

                HorizontalLayout {
                    spacing: 10px;
                    ActionButton {
                        label: "Refresh DAG";
                        variant: "secondary";
                        btn-height: 30px;
                        clicked => { root.refresh_graph_requested(); }
                        IconRefresh { icon-size: 12px; icon-color: Theme.text-secondary; }
                    }
                    ActionButton {
                        label: "Export Graphviz (.dot)";
                        variant: "primary";
                        btn-height: 30px;
                        clicked => { root.export_dot_requested(); }
                        IconExport { icon-size: 12px; icon-color: #FFFFFF; }
                    }
                }
            }
        }

        // 5-Stage Layered Causal Pipeline
        PanelCard {
            vertical-stretch: 3;
            title: "Directed Acyclic Causality Flow";
            subtitle: "Click any entity node across causal stages to inspect supporting evidence edges";

            HorizontalLayout {
                vertical-stretch: 1;
                spacing: 6px;

                StageColumn { stage-title: "1. REVISION"; target-tier: 0; nodes: root.nodes; selected-idx: root.selected_node_idx; node-clicked(i) => { root.selected_node_idx = i; root.node_selected(i); } }
                StageArrow {}
                StageColumn { stage-title: "2. BUILDS"; target-tier: 1; nodes: root.nodes; selected-idx: root.selected_node_idx; node-clicked(i) => { root.selected_node_idx = i; root.node_selected(i); } }
                StageArrow {}
                StageColumn { stage-title: "3. ENVIRONMENT"; target-tier: 2; nodes: root.nodes; selected-idx: root.selected_node_idx; node-clicked(i) => { root.selected_node_idx = i; root.node_selected(i); } }
                StageArrow {}
                StageColumn { stage-title: "4. ARTIFACT DIFF"; target-tier: 3; nodes: root.nodes; selected-idx: root.selected_node_idx; node-clicked(i) => { root.selected_node_idx = i; root.node_selected(i); } }
                StageArrow {}
                StageColumn { stage-title: "5. RCA & FIX"; target-tier: 4; nodes: root.nodes; selected-idx: root.selected_node_idx; node-clicked(i) => { root.selected_node_idx = i; root.node_selected(i); } }
            }
        }

        // Bottom Causal Edges & Node Evidence Inspector
        PanelCard {
            vertical-stretch: 2;
            title: (root.selected_node_idx >= 0 && root.selected_node_idx < root.nodes.length)
                ? ("Causal Links for Node: " + root.nodes[root.selected_node_idx].label)
                : "Evidence-Backed Causal Edges (" + root.edges.length + ")";
            subtitle: "Edges track causal provenance with strict epistemic verification tags";

            if root.edges.length == 0: Rectangle {
                vertical-stretch: 1;
                Text {
                    text: "No causal edges generated yet. Trigger a build comparison to synthesize the DAG.";
                    color: Theme.text-muted;
                    font-size: 12px;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
            }

            if root.edges.length > 0: ListView {
                vertical-stretch: 1;
                for edge in root.edges: Rectangle {
                    height: 36px;
                    background: Theme.bg-elevated;
                    border-radius: Theme.radius-xs;
                    border-width: 1px;
                    border-color: Theme.border-subtle;

                    HorizontalLayout {
                        padding-left: 10px;
                        padding-right: 10px;
                        spacing: 10px;

                        Text { text: edge.source_id; color: Theme.text-code; font-size: 11px; width: 130px; overflow: elide; vertical-alignment: center; }
                        Text { text: "-> [" + edge.relation + "] ->"; color: Theme.accent-cyan; font-size: 10.5px; font-weight: 700; width: 155px; horizontal-alignment: center; vertical-alignment: center; }
                        Text { text: edge.target_id; color: Theme.text-code; font-size: 11px; width: 130px; overflow: elide; vertical-alignment: center; }
                        Text { text: edge.evidence; color: Theme.text-secondary; font-size: 11px; horizontal-stretch: 1; overflow: elide; vertical-alignment: center; }
                        VerticalLayout {
                            alignment: center;
                            StatusBadge {
                                text: edge.epistemic_status;
                                kind: edge.epistemic_status == "EXPERIMENTALLY_VALIDATED" ? "success" : (edge.epistemic_status == "OBSERVED" ? "info" : "warning");
                            }
                        }
                    }
                }
            }
        }
    }
}
