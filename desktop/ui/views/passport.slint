import { Theme } from "../theme.slint";
import { ActionButton } from "../components/action_button.slint";
import { PanelCard } from "../components/panel_card.slint";
import { StatusBadge } from "../components/status_badge.slint";
import { IconExport, IconPassport } from "../components/icons.slint";

export component PassportView inherits Rectangle {
    in property <string> passport_json: "";
    in property <string> passport_repo: "";
    in property <string> passport_status: "UNVERIFIED";

    callback export_json_requested();
    callback export_md_requested();

    background: Theme.bg-canvas;

    VerticalLayout {
        padding: 20px;
        spacing: 14px;

        PanelCard {
            inner-padding: 14px;
            HorizontalLayout {
                alignment: space-between;
                spacing: 12px;

                HorizontalLayout {
                    spacing: 12px;
                    VerticalLayout {
                        alignment: center;
                        Rectangle {
                            width: 36px;
                            height: 36px;
                            border-radius: Theme.radius-sm;
                            background: Theme.status-success-soft;
                            border-width: 1px;
                            border-color: Theme.status-success;
                            VerticalLayout {
                                alignment: center;
                                HorizontalLayout {
                                    alignment: center;
                                    IconPassport { icon-size: 18px; icon-color: Theme.status-success; }
                                }
                            }
                        }
                    }
                    VerticalLayout {
                        spacing: 3px;
                        Text {
                            text: root.passport_repo != "" ? ("Reproducibility Passport • " + root.passport_repo) : "Reproducibility Passport (v1.0 Schema)";
                            color: Theme.text-primary;
                            font-size: 14px;
                            font-weight: 700;
                        }
                        HorizontalLayout {
                            spacing: 8px;
                            StatusBadge {
                                text: root.passport_status;
                                kind:
                                    root.passport_status == "VERIFIED_BIT_FOR_BIT" ? "success" :
                                    root.passport_status == "VERIFIED_NORMALIZED" ? "info" :
                                    root.passport_status == "DRIFT_DETECTED" ? "warning" :
                                    "neutral";
                            }
                            Text {
                                text: "Sanitized, schema-versioned provenance & epistemic audit";
                                color: Theme.text-muted;
                                font-size: 11px;
                                vertical-alignment: center;
                            }
                        }
                    }
                }

                HorizontalLayout {
                    spacing: 10px;
                    ActionButton {
                        label: "Export JSON";
                        variant: "secondary";
                        btn-height: 32px;
                        clicked => { root.export_json_requested(); }
                        IconExport { icon-size: 12px; icon-color: Theme.text-secondary; }
                    }
                    ActionButton {
                        label: "Export Markdown";
                        variant: "primary";
                        btn-height: 32px;
                        clicked => { root.export_md_requested(); }
                        IconExport { icon-size: 12px; icon-color: #FFFFFF; }
                    }
                }
            }
        }

        PanelCard {
            vertical-stretch: 1;
            title: "Passport Provenance Payload (reproforge-passport-v1.0.json)";
            subtitle: "Secrets & raw host credentials are automatically redacted before export";

            Rectangle {
                vertical-stretch: 1;
                background: Theme.bg-deep;
                border-radius: Theme.radius-sm;
                border-width: 1px;
                border-color: Theme.border-subtle;
                clip: true;

                Flickable {
                    content-height: passport-text.preferred-height + 24px;
                    VerticalLayout {
                        padding: 14px;
                        passport-text := Text {
                            text: root.passport_json != "" ? root.passport_json : "Select a repository to inspect or export its versioned Reproducibility Passport.";
                            color: Theme.text-code;
                            font-size: 11.5px;
                            wrap: word-wrap;
                        }
                    }
                }
            }
        }
    }
}
