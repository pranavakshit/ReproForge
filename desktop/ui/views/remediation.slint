import { ListView } from "std-widgets.slint";
import { Theme } from "../theme.slint";
import { ActionButton } from "../components/action_button.slint";
import { PanelCard } from "../components/panel_card.slint";
import { StatusBadge } from "../components/status_badge.slint";
import { IconCheck, IconPlay } from "../components/icons.slint";

export struct RemediationProposal {
    id: string,
    tier: string,
    title: string,
    description: string,
    patch_preview: string,
    status: string,
    confidence: string,
    requires_approval: bool,
}

export component RemediationView inherits Rectangle {
    in property <[RemediationProposal]> proposals: [];
    in-out property <int> selected_proposal_idx: -1;

    callback proposal_selected(int);
    callback approve_patch_requested(string);
    callback run_verification_rebuild_requested();

    background: Theme.bg-canvas;

    VerticalLayout {
        padding: 20px;
        spacing: 14px;

        // Top 3-Tier Safety Policy Header
        PanelCard {
            inner-padding: 12px;
            HorizontalLayout {
                alignment: space-between;
                spacing: 12px;
                HorizontalLayout {
                    spacing: 8px;
                    StatusBadge { text: "L1: Disposable Sandbox Auto-Repair"; kind: "info"; }
                    StatusBadge { text: "L2: Approval-Gated Patch"; kind: "warning"; }
                    StatusBadge { text: "L3: Diagnosis Only"; kind: "neutral"; }
                }
                ActionButton {
                    label: "Run Verification Rebuild";
                    variant: "primary";
                    btn-height: 30px;
                    clicked => { root.run_verification_rebuild_requested(); }
                    IconPlay { icon-size: 11px; icon-color: #FFFFFF; }
                }
            }
        }

        HorizontalLayout {
            vertical-stretch: 1;
            spacing: 16px;

            // Left Proposals List
            PanelCard {
                horizontal-stretch: 2;
                title: "Remediation Proposals (" + root.proposals.length + ")";
                subtitle: "Evidence-derived fixes ordered by reproducibility safety tier";

                if root.proposals.length == 0: Rectangle {
                    vertical-stretch: 1;
                    Text {
                        text: "No remediation patches queued. Diagnostic findings generate ranked repair proposals here.";
                        color: Theme.text-muted;
                        font-size: 12px;
                        wrap: word-wrap;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                }

                if root.proposals.length > 0: ListView {
                    vertical-stretch: 1;
                    for p[idx] in root.proposals: Rectangle {
                        height: 76px;
                        border-radius: Theme.radius-sm;
                        background: idx == root.selected_proposal_idx ? Theme.accent-primary-soft : (p-ta.has-hover ? Theme.bg-hover : Theme.bg-elevated);
                        border-width: 1px;
                        border-color: idx == root.selected_proposal_idx ? Theme.accent-primary : Theme.border-subtle;

                        VerticalLayout {
                            padding: 10px;
                            spacing: 4px;
                            HorizontalLayout {
                                spacing: 6px;
                                StatusBadge { text: p.tier; kind: p.tier == "LEVEL_1" ? "info" : (p.tier == "LEVEL_2" ? "warning" : "neutral"); }
                                StatusBadge { text: p.status; kind: p.status == "VERIFIED" || p.status == "APPLIED" ? "success" : "neutral"; }
                                Text { text: p.confidence; color: Theme.accent-cyan; font-size: 10.5px; horizontal-stretch: 1; horizontal-alignment: right; vertical-alignment: center; }
                            }
                            Text { text: p.title; color: Theme.text-primary; font-size: 12px; font-weight: 700; overflow: elide; }
                            Text { text: p.description; color: Theme.text-secondary; font-size: 11px; overflow: elide; }
                        }

                        p-ta := TouchArea {
                            mouse-cursor: pointer;
                            clicked => {
                                root.selected_proposal_idx = idx;
                                root.proposal_selected(idx);
                            }
                        }
                    }
                }
            }

            // Right Patch Diff & Approval Gate
            PanelCard {
                horizontal-stretch: 3;
                title: (root.selected_proposal_idx >= 0 && root.selected_proposal_idx < root.proposals.length)
                    ? root.proposals[root.selected_proposal_idx].title
                    : "Patch Diff & Disposable Verification Workspace";
                subtitle: "Patches are applied only inside isolated copy workspaces until independently verified";

                Rectangle {
                    vertical-stretch: 1;
                    background: Theme.bg-deep;
                    border-radius: Theme.radius-sm;
                    border-width: 1px;
                    border-color: Theme.border-subtle;
                    clip: true;

                    Flickable {
                        content-height: patch-txt.preferred-height + 20px;
                        VerticalLayout {
                            padding: 12px;
                            patch-txt := Text {
                                text: (root.selected_proposal_idx >= 0 && root.selected_proposal_idx < root.proposals.length)
                                    ? root.proposals[root.selected_proposal_idx].patch_preview
                                    : "Select a remediation proposal on the left to inspect its unified diff before approval.";
                                color: Theme.text-code;
                                font-size: 11.5px;
                                wrap: word-wrap;
                            }
                        }
                    }
                }

                if root.selected_proposal_idx >= 0 && root.selected_proposal_idx < root.proposals.length: HorizontalLayout {
                    alignment: space-between;
                    Text {
                        text: root.proposals[root.selected_proposal_idx].requires_approval
                            ? "Requires explicit user approval before workspace repair."
                            : "Safe deterministic repair (isolated disposable copy).";
                        color: Theme.text-secondary;
                        font-size: 11px;
                        vertical-alignment: center;
                    }
                    ActionButton {
                        label: "Approve & Test in Disposable Workspace";
                        variant: "success";
                        btn-height: 32px;
                        clicked => {
                            root.approve_patch_requested(root.proposals[root.selected_proposal_idx].id);
                        }
                        IconCheck { icon-size: 12px; icon-color: #6EE7B7; }
                    }
                }
            }
        }
    }
}
