import { ListView } from "std-widgets.slint";
import { Theme } from "../theme.slint";
import { ActionButton } from "../components/action_button.slint";
import { PanelCard } from "../components/panel_card.slint";
import { ProgressMeter } from "../components/progress_meter.slint";
import { StatusBadge } from "../components/status_badge.slint";
import { IconExport, IconFolder } from "../components/icons.slint";

export struct DiffEntry {
    path: string,
    diff_type: string,
    status: string,
    size_delta: string,
    snippet: string,
}

export struct DiagnosticFindingItem {
    rule_id: string,
    severity: string,
    category: string,
    title: string,
    epistemic_status: string,
    summary: string,
    remediation: string,
}

export component DiagnosticsView inherits Rectangle {
    in property <string> diag_target_a: "Awaiting Target A";
    in property <string> diag_target_b: "Awaiting Target B";
    in property <string> diag_verdict: "UNCOMPARED";
    in property <float> cri_content: 0.0;
    in property <float> cri_metadata: 0.0;
    in property <float> cri_environment: 0.0;
    in property <[DiffEntry]> diff_entries: [];
    in-out property <int> diff_selected_idx: -1;
    in property <string> selected_diff_snippet: "";
    in property <[DiagnosticFindingItem]> diagnostic_findings: [];

    // CLI `reproforge compare <a1> <a2>` & `ReportExporter` parity inputs
    in-out property <string> custom_path_a: "";
    in-out property <string> custom_path_b: "";

    callback diff_entry_selected(int);
    callback compare_latest_requested();
    callback pick_custom_path_a_requested();
    callback pick_custom_path_b_requested();
    callback compare_custom_paths_requested();
    callback export_report_requested(string);

    background: Theme.bg-canvas;

    VerticalLayout {
        padding: 20px;
        spacing: 14px;

        // Top Comparison Header + CRI Metric Vector Decomposition
        PanelCard {
            title: "Pairwise Comparison & CRI Metric Vector";
            subtitle: "Granular archive diff inspection, CLI artifact compare parity, and report exports";

            HorizontalLayout {
                spacing: 16px;

                VerticalLayout {
                    horizontal-stretch: 1;
                    spacing: 6px;
                    Text { text: "MODE A: " + root.diag_target_a; color: Theme.text-code; font-size: 11.5px; font-weight: 600; overflow: elide; }
                    Text { text: "MODE B: " + root.diag_target_b; color: Theme.text-code; font-size: 11.5px; font-weight: 600; overflow: elide; }
                    HorizontalLayout {
                        spacing: 6px;
                        Text { text: "Verdict:"; color: Theme.text-muted; font-size: 11.5px; vertical-alignment: center; }
                        StatusBadge {
                            text: root.diag_verdict;
                            kind:
                                root.diag_verdict == "BIT_FOR_BIT" || root.diag_verdict == "BIT_FOR_BIT_REPRODUCIBLE" || root.diag_verdict == "REPRODUCIBLE" ? "success" :
                                root.diag_verdict == "NORMALIZED" || root.diag_verdict == "NORMALIZED_REPRODUCIBLE" || root.diag_verdict == "EQUIVALENT" ? "info" :
                                root.diag_verdict == "DRIFT" || root.diag_verdict == "DIVERGENT" || root.diag_verdict == "NON_REPRODUCIBLE" ? "warning" :
                                "neutral";
                        }
                        ActionButton {
                            label: "Compare Latest 2";
                            variant: "secondary";
                            btn-height: 26px;
                            clicked => { root.compare_latest_requested(); }
                        }
                        ActionButton {
                            label: "HTML";
                            variant: "ghost";
                            btn-height: 26px;
                            h-pad: 8px;
                            clicked => { root.export_report_requested("html"); }
                            IconExport { icon-size: 11px; icon-color: Theme.text-secondary; }
                        }
                        ActionButton {
                            label: "CSV";
                            variant: "ghost";
                            btn-height: 26px;
                            h-pad: 8px;
                            clicked => { root.export_report_requested("csv"); }
                        }
                        ActionButton {
                            label: "JSON";
                            variant: "ghost";
                            btn-height: 26px;
                            h-pad: 8px;
                            clicked => { root.export_report_requested("json"); }
                        }
                    }
                }

                HorizontalLayout {
                    horizontal-stretch: 2;
                    spacing: 14px;
                    ProgressMeter {
                        horizontal-stretch: 1;
                        label: "Content Agreement";
                        ratio: root.cri_content;
                        fill-color: Theme.status-success;
                    }
                    ProgressMeter {
                        horizontal-stretch: 1;
                        label: "Metadata Agreement";
                        ratio: root.cri_metadata;
                        fill-color: Theme.accent-cyan;
                    }
                    ProgressMeter {
                        horizontal-stretch: 1;
                        label: "Env Consistency";
                        ratio: root.cri_environment;
                        fill-color: Theme.accent-indigo;
                    }
                }
            }

            // Custom Compare Bar (`reproforge compare <a1> <a2>`)
            HorizontalLayout {
                spacing: 8px;
                Text { text: "Compare Paths:"; color: Theme.text-muted; font-size: 11px; vertical-alignment: center; }

                Rectangle {
                    horizontal-stretch: 1;
                    height: 28px;
                    background: Theme.bg-input;
                    border-radius: Theme.radius-xs;
                    border-width: 1px;
                    border-color: Theme.border-subtle;
                    clip: true;
                    pa := TextInput {
                        x: 8px;
                        y: 5px;
                        width: parent.width - 16px;
                        text <=> root.custom_path_a;
                        color: Theme.text-code;
                        font-size: 11px;
                        single-line: true;
                    }
                    if pa.text == "" && !pa.has-focus: Text { x: 8px; y: 6px; text: "Artifact 1 path (.whl / .tar / .zip / file)..."; color: Theme.text-muted; font-size: 10.5px; }
                }
                ActionButton {
                    label: "File A";
                    variant: "secondary";
                    btn-height: 28px;
                    h-pad: 9px;
                    clicked => { root.pick_custom_path_a_requested(); }
                    IconFolder { icon-size: 11px; icon-color: Theme.text-secondary; }
                }

                Rectangle {
                    horizontal-stretch: 1;
                    height: 28px;
                    background: Theme.bg-input;
                    border-radius: Theme.radius-xs;
                    border-width: 1px;
                    border-color: Theme.border-subtle;
                    clip: true;
                    pb := TextInput {
                        x: 8px;
                        y: 5px;
                        width: parent.width - 16px;
                        text <=> root.custom_path_b;
                        color: Theme.text-code;
                        font-size: 11px;
                        single-line: true;
                    }
                    if pb.text == "" && !pb.has-focus: Text { x: 8px; y: 6px; text: "Artifact 2 path (.whl / .tar / .zip / file)..."; color: Theme.text-muted; font-size: 10.5px; }
                }
                ActionButton {
                    label: "File B";
                    variant: "secondary";
                    btn-height: 28px;
                    h-pad: 9px;
                    clicked => { root.pick_custom_path_b_requested(); }
                    IconFolder { icon-size: 11px; icon-color: Theme.text-secondary; }
                }

                ActionButton {
                    label: "Compare Files";
                    variant: "primary";
                    btn-height: 28px;
                    clicked => { root.compare_custom_paths_requested(); }
                }
            }
        }

        // Main Split: Left File/Byte Diffs + Right RCA Findings
        HorizontalLayout {
            vertical-stretch: 1;
            spacing: 16px;

            PanelCard {
                horizontal-stretch: 3;
                title: "Artifact Entry Differences (" + root.diff_entries.length + ")";
                subtitle: "Click any entry to inspect bounded byte/text diff context";

                if root.diff_entries.length == 0: Rectangle {
                    vertical-stretch: 1;
                    Text {
                        text: "Bit-for-bit aligned or no divergence entries recorded for the latest comparison.";
                        color: Theme.text-muted;
                        font-size: 12px;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                        wrap: word-wrap;
                    }
                }

                if root.diff_entries.length > 0: ListView {
                    vertical-stretch: 2;
                    for item[idx] in root.diff_entries: Rectangle {
                        height: 44px;
                        border-radius: Theme.radius-xs;
                        background: idx == root.diff_selected_idx ? Theme.accent-primary-soft : (d-ta.has-hover ? Theme.bg-hover : Theme.bg-elevated);
                        border-width: 1px;
                        border-color: idx == root.diff_selected_idx ? Theme.accent-primary : Theme.border-subtle;

                        HorizontalLayout {
                            padding-left: 10px;
                            padding-right: 10px;
                            spacing: 10px;
                            Text {
                                text: item.path;
                                color: Theme.text-primary;
                                font-size: 11.5px;
                                font-weight: 600;
                                horizontal-stretch: 1;
                                vertical-alignment: center;
                                overflow: elide;
                            }
                            Text {
                                text: item.diff_type;
                                color: Theme.text-secondary;
                                font-size: 10.5px;
                                width: 88px;
                                vertical-alignment: center;
                            }
                            Text {
                                text: item.size_delta;
                                color: Theme.accent-cyan;
                                font-size: 10.5px;
                                width: 70px;
                                vertical-alignment: center;
                                horizontal-alignment: right;
                            }
                            VerticalLayout {
                                alignment: center;
                                StatusBadge {
                                    text: item.status;
                                    kind: item.status == "CONTENT" || item.status == "BYTE_DIFF" ? "danger" : "warning";
                                }
                            }
                        }

                        d-ta := TouchArea {
                            mouse-cursor: pointer;
                            clicked => {
                                root.diff_selected_idx = idx;
                                root.diff_entry_selected(idx);
                            }
                        }
                    }
                }

                if root.selected_diff_snippet != "": Rectangle {
                    vertical-stretch: 1;
                    min-height: 90px;
                    background: Theme.bg-deep;
                    border-radius: Theme.radius-sm;
                    border-width: 1px;
                    border-color: Theme.border-subtle;
                    clip: true;

                    Flickable {
                        content-height: snip.preferred-height + 16px;
                        VerticalLayout {
                            padding: 10px;
                            snip := Text {
                                text: root.selected_diff_snippet;
                                color: Theme.text-code;
                                font-size: 11px;
                                wrap: word-wrap;
                            }
                        }
                    }
                }
            }

            PanelCard {
                horizontal-stretch: 2;
                title: "Diagnostic Root Causes (" + root.diagnostic_findings.length + ")";
                subtitle: "Rule-based RCA findings tagged by epistemic validation";

                if root.diagnostic_findings.length == 0: Rectangle {
                    vertical-stretch: 1;
                    Text {
                        text: "No root-cause anomalies triggered for this comparison.";
                        color: Theme.text-muted;
                        font-size: 12px;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                }

                if root.diagnostic_findings.length > 0: ListView {
                    vertical-stretch: 1;
                    for f in root.diagnostic_findings: VerticalLayout {
                        padding-bottom: 6px;
                        Rectangle {
                            min-height: 116px;
                            background: Theme.bg-elevated;
                            border-radius: Theme.radius-sm;
                            border-width: 1px;
                            border-color: Theme.border-subtle;

                            VerticalLayout {
                                padding: 10px;
                                spacing: 6px;

                                HorizontalLayout {
                                    spacing: 6px;
                                    StatusBadge {
                                        text: f.epistemic_status;
                                        kind:
                                            f.epistemic_status == "EXPERIMENTALLY_VALIDATED" ? "success" :
                                            f.epistemic_status == "OBSERVED" ? "info" :
                                            f.epistemic_status == "INFERRED" ? "warning" :
                                            "neutral";
                                    }
                                    StatusBadge {
                                        text: f.severity;
                                        kind: f.severity == "HIGH" || f.severity == "CRITICAL" ? "danger" : "warning";
                                    }
                                    Text {
                                        text: f.category;
                                        color: Theme.text-muted;
                                        font-size: 10.5px;
                                        horizontal-stretch: 1;
                                        horizontal-alignment: right;
                                        vertical-alignment: center;
                                    }
                                }

                                Text {
                                    text: f.title;
                                    color: Theme.text-primary;
                                    font-size: 12px;
                                    font-weight: 700;
                                    wrap: word-wrap;
                                }

                                Text {
                                    text: f.summary;
                                    color: Theme.text-secondary;
                                    font-size: 11px;
                                    wrap: word-wrap;
                                }

                                if f.remediation != "": Text {
                                    text: "Fix: " + f.remediation;
                                    color: #6EE7B7;
                                    font-size: 10.5px;
                                    wrap: word-wrap;
                                }
                            }
                        }
                    }
                }
            }
        }
    }
}
