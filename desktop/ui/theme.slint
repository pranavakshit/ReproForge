// ReproForge Obsidian Design System Tokens
// Zero blur shaders, hairline 1px contrast, minimal runtime footprint.

export global Theme {
    // Surface Hierarchy
    out property <color> bg-canvas: #090D16;
    out property <color> bg-deep: #070B12;
    out property <color> bg-sidebar: #0D1320;
    out property <color> bg-header: #0E1523;
    out property <color> bg-card: #121A2A;
    out property <color> bg-elevated: #162136;
    out property <color> bg-hover: #1B2840;
    out property <color> bg-input: #0B101B;

    // Hairline Borders
    out property <color> border-subtle: #1D283D;
    out property <color> border-muted: #27354F;
    out property <color> border-active: #3B82F6;

    // Typography Colors
    out property <color> text-primary: #F1F5F9;
    out property <color> text-secondary: #94A3B8;
    out property <color> text-muted: #64748B;
    out property <color> text-code: #CBD5E1;

    // Semantic Brand & Status Accents
    out property <color> accent-primary: #3B82F6;
    out property <color> accent-primary-soft: #13284A;
    out property <color> accent-cyan: #22D3EE;
    out property <color> accent-indigo: #6366F1;

    out property <color> status-success: #10B981;
    out property <color> status-success-soft: #0C2B25;
    out property <color> status-warning: #F59E0B;
    out property <color> status-warning-soft: #31230E;
    out property <color> status-danger: #EF4444;
    out property <color> status-danger-soft: #33141B;
    out property <color> status-info: #06B6D4;
    out property <color> status-info-soft: #0C2938;

    // Legacy Aliases for Backwards Compatibility Across Views
    out property <color> surface: #121A2A;
    out property <color> surface-hover: #1B2840;
    out property <color> accent: #3B82F6;
    out property <color> border: #1D283D;

    // Radii & Spacing
    out property <length> radius-xs: 4px;
    out property <length> radius-sm: 6px;
    out property <length> radius-md: 10px;
    out property <length> radius-lg: 14px;
    out property <length> radius-pill: 999px;

    out property <length> space-xs: 6px;
    out property <length> space-sm: 10px;
    out property <length> space-md: 16px;
    out property <length> space-lg: 22px;
}
