import { Theme } from "./theme.slint";
import { Sidebar } from "./components/sidebar.slint";
import { AppHeader } from "./components/app_header.slint";
import { AboutModal } from "./components/about_modal.slint";
import {
    OverviewView, RecentBuildItem
} from "./views/overview.slint";
import {
    ReposView, RepoItem, RevisionItem, WorkspaceCandidateItem
} from "./views/repos.slint";
import {
    BuildsView, BuildRowData
} from "./views/builds.slint";
import {
    DiagnosticsView, DiffEntry, DiagnosticFindingItem
} from "./views/diagnostics.slint";
import {
    CausalityGraphView, GraphNodeItem, GraphEdgeItem
} from "./views/causality_graph.slint";
import {
    PerturbationView, PerturbationParam, SensitivityResult
} from "./views/perturbation.slint";
import { PassportView } from "./views/passport.slint";
import {
    RemediationView, RemediationProposal
} from "./views/remediation.slint";
import { SettingsView } from "./views/settings.slint";

export {
    BuildRowData, RepoItem, RevisionItem, RecentBuildItem, WorkspaceCandidateItem,
    DiffEntry, DiagnosticFindingItem,
    GraphNodeItem, GraphEdgeItem,
    PerturbationParam, SensitivityResult,
    RemediationProposal
}

export component MainWindow inherits Window {
    title: "ReproForge — Software Build Reproducibility & Diagnostic Studio";
    preferred-width: 1280px;
    preferred-height: 820px;
    min-width: 980px;
    min-height: 660px;
    background: Theme.bg-canvas;

    // Navigation & Shell State
    in-out property <int> active_tab: 0;
    in-out property <bool> show_about: false;
    in-out property <string> app_version: "0.2.0";
    in-out property <string> engine_status: "Engine Initializing...";
    in-out property <bool> engine_healthy: false;
    in-out property <string> engine_backend: "IPC";
    in-out property <string> search_query: "";
    in-out property <string> status_banner: "";

    // Overview Metrics & Telemetry
    in-out property <string> total_builds: "0";
    in-out property <string> total_comparisons: "0";
    in-out property <string> bit_for_bit_rate: "0.0%";
    in-out property <string> normalized_rate: "0.0%";
    in-out property <string> unresolved_count: "0";
    in-out property <float> cri_bit_ratio: 0.0;
    in-out property <float> cri_norm_ratio: 0.0;
    in-out property <float> cri_drift_ratio: 0.0;
    in-out property <string> host_os: "Detecting...";
    in-out property <string> host_arch: "—";
    in-out property <string> detected_toolchains: "Probing local environment...";
    in-out property <string> docker_cli_version: "Probing...";
    in-out property <string> database_path: "data/reproforge.db";
    in-out property <[RecentBuildItem]> recent_builds: [];

    // Repositories & GitHub Autoscan
    in-out property <[RepoItem]> repos: [];
    in-out property <int> selected_repo_idx: 0;
    in-out property <[RevisionItem]> revisions: [];
    in-out property <int> selected_revision_idx: 0;
    in-out property <string> repo_input_path: "";
    in-out property <bool> fetch_online_github: true;
    in-out property <[WorkspaceCandidateItem]> workspace_candidates: [];
    in-out property <bool> show_workspace_checklist: false;
    in-out property <string> workspace_folder_path: "";
    in-out property <string> workspace_checklist_status: "";

    // Builds & Logs
    in-out property <[BuildRowData]> builds: [];
    in-out property <int> selected_build_idx: 0;
    in-out property <string> selected_build_log: "";
    in-out property <string> selected_hash: "Select a build to inspect primary SHA-256";
    in-out property <string> selected_artifact_count: "0 artifacts";
    in-out property <string> selected_backend_type: "local";
    in-out property <string> active_target_label: "—";
    in-out property <int> active_build_count: 0;

    // Diff & Diagnostics (Milestone F)
    in-out property <string> diag_target_a: "Awaiting comparison...";
    in-out property <string> diag_target_b: "Awaiting comparison...";
    in-out property <string> diag_verdict: "UNCOMPARED";
    in-out property <float> cri_content: 0.0;
    in-out property <float> cri_metadata: 0.0;
    in-out property <float> cri_environment: 0.0;
    in-out property <[DiffEntry]> diff_entries: [];
    in-out property <int> diff_selected_idx: -1;
    in-out property <string> selected_diff_snippet: "";
    in-out property <[DiagnosticFindingItem]> diagnostic_findings: [];

    // Causality Graph (Milestone F)
    in-out property <[GraphNodeItem]> graph_nodes: [];
    in-out property <[GraphEdgeItem]> graph_edges: [];
    in-out property <int> selected_graph_node_idx: -1;

    // Perturbation Lab (Milestone G)
    in-out property <[PerturbationParam]> perturbation_params: [];
    in-out property <[SensitivityResult]> sensitivity_results: [];
    in-out property <bool> perturbation_running: false;

    // Passport & Audit (Milestone G)
    in-out property <string> passport_json: "";
    in-out property <string> passport_repo: "";
    in-out property <string> passport_status: "UNVERIFIED";

    // Self-Healing & Remediation (Milestone G)
    in-out property <[RemediationProposal]> remediation_proposals: [];
    in-out property <int> selected_proposal_idx: -1;

    // Settings & Storage
    in-out property <string> storage_db_path: "data/reproforge.db";
    in-out property <string> storage_artifacts_path: "collected_artifacts";
    in-out property <string> storage_workspaces_path: "build_workspaces";
    in-out property <bool> docker_available: false;

    // Application Callbacks
    callback refresh_requested();
    callback search_changed(string);
    callback build_row_clicked(int);
    callback repo_selected(int);
    callback revision_selected(int);
    callback trigger_build_requested();
    callback verify_pair_requested();
    callback compare_latest_requested();
    callback build_specific_revision_requested(string);
    callback cancel_build_requested();
    callback backend_type_selected(string);

    // GitHub Autoscan & Folder Checklist Callbacks
    callback register_local_repo_requested();
    callback browse_folder_requested();
    callback scan_folder_requested(string);
    callback autoscan_repo_requested();
    callback checklist_item_toggled(int);
    callback checklist_select_all_untracked();
    callback confirm_workspace_checklist();
    callback dismiss_workspace_checklist();

    // Diagnostics & Causality Graph Callbacks
    callback diff_entry_selected(int);
    callback graph_node_selected(int);
    callback refresh_graph_requested();
    callback export_dot_requested();

    // Milestone G Callbacks
    callback run_perturbation_campaign_requested();
    callback export_passport_json_requested();
    callback export_passport_md_requested();
    callback remediation_proposal_selected(int);
    callback approve_patch_requested(string);
    callback run_verification_rebuild_requested();

    // Keyboard Shortcuts
    FocusScope {
        key-pressed(event) => {
            if event.modifiers.control {
                if event.text == "1" { root.active_tab = 0; return accept; }
                if event.text == "2" { root.active_tab = 1; return accept; }
                if event.text == "3" { root.active_tab = 2; return accept; }
                if event.text == "4" { root.active_tab = 3; return accept; }
                if event.text == "5" { root.active_tab = 4; return accept; }
                if event.text == "6" { root.active_tab = 5; return accept; }
                if event.text == "7" { root.active_tab = 6; return accept; }
                if event.text == "8" { root.active_tab = 7; return accept; }
                if event.text == "9" { root.active_tab = 8; return accept; }
                if event.text == "r" || event.text == "R" { root.refresh_requested(); return accept; }
            }
            return reject;
        }

        HorizontalLayout {
            spacing: 0px;

            Sidebar {
                active_tab <=> root.active_tab;
                app_version: root.app_version;
            }

            VerticalLayout {
                horizontal-stretch: 1;
                spacing: 0px;

                AppHeader {
                    active_title:
                        root.active_tab == 0 ? "Overview & Telemetry" :
                        root.active_tab == 1 ? "Repositories & GitHub Autoscan" :
                        root.active_tab == 2 ? "Build Orchestration & Logs" :
                        root.active_tab == 3 ? "Diff & RCA Diagnostics" :
                        root.active_tab == 4 ? "Build Drift Causality Graph" :
                        root.active_tab == 5 ? "Perturbation Lab" :
                        root.active_tab == 6 ? "Reproducibility Passport" :
                        root.active_tab == 7 ? "Self-Healing Remediation" :
                        "Settings & Storage";
                    engine_status: root.engine_status;
                    engine_healthy: root.engine_healthy;
                    engine_backend: root.engine_backend;
                    app_version: root.app_version;
                    search_query <=> root.search_query;
                    search_changed(q) => { root.search_changed(q); }
                    refresh_requested => { root.refresh_requested(); }
                    about_requested => { root.show_about = true; }
                }

                // Subtle dismissible/live status banner when non-empty
                if root.status_banner != "": Rectangle {
                    height: 30px;
                    background: Theme.accent-primary-soft;
                    Rectangle {
                        y: parent.height - 1px;
                        height: 1px;
                        width: parent.width;
                        background: #1D4ED8;
                    }
                    HorizontalLayout {
                        padding-left: 20px;
                        padding-right: 20px;
                        alignment: space-between;
                        Text {
                            text: root.status_banner;
                            color: #93C5FD;
                            font-size: 11.5px;
                            font-weight: 500;
                            vertical-alignment: center;
                            overflow: elide;
                        }
                        TouchArea {
                            width: 60px;
                            mouse-cursor: pointer;
                            clicked => { root.status_banner = ""; }
                            Text {
                                text: "Dismiss";
                                color: Theme.text-secondary;
                                font-size: 11px;
                                vertical-alignment: center;
                                horizontal-alignment: right;
                            }
                        }
                    }
                }

                // Active View Container
                Rectangle {
                    vertical-stretch: 1;
                    background: Theme.bg-canvas;
                    clip: true;

                    if root.active_tab == 0: OverviewView {
                        width: 100%;
                        height: 100%;
                        total_builds: root.total_builds;
                        total_comparisons: root.total_comparisons;
                        bit_for_bit_rate: root.bit_for_bit_rate;
                        normalized_rate: root.normalized_rate;
                        unresolved_count: root.unresolved_count;
                        cri_bit_ratio: root.cri_bit_ratio;
                        cri_norm_ratio: root.cri_norm_ratio;
                        cri_drift_ratio: root.cri_drift_ratio;
                        host_os: root.host_os;
                        host_arch: root.host_arch;
                        detected_toolchains: root.detected_toolchains;
                        docker_cli_version: root.docker_cli_version;
                        database_path: root.database_path;
                        recent_builds: root.recent_builds;
                        inspect_build_requested(idx) => {
                            root.selected_build_idx = idx;
                            root.build_row_clicked(idx);
                            root.active_tab = 2;
                        }
                    }

                    if root.active_tab == 1: ReposView {
                        width: 100%;
                        height: 100%;
                        repos: root.repos;
                        selected_repo_idx <=> root.selected_repo_idx;
                        revisions: root.revisions;
                        selected_revision_idx <=> root.selected_revision_idx;
                        repo_input_path <=> root.repo_input_path;
                        fetch_online_github <=> root.fetch_online_github;
                        workspace_candidates: root.workspace_candidates;
                        show_workspace_checklist: root.show_workspace_checklist;
                        workspace_folder_path: root.workspace_folder_path;
                        workspace_checklist_status: root.workspace_checklist_status;
                        repo_selected(idx) => { root.repo_selected(idx); }
                        revision_selected(idx) => { root.revision_selected(idx); }
                        browse_folder_requested => { root.browse_folder_requested(); }
                        scan_folder_requested(path) => { root.scan_folder_requested(path); }
                        autoscan_repo_requested => { root.autoscan_repo_requested(); }
                        checklist_item_toggled(idx) => { root.checklist_item_toggled(idx); }
                        checklist_select_all_untracked => { root.checklist_select_all_untracked(); }
                        confirm_workspace_checklist => { root.confirm_workspace_checklist(); }
                        dismiss_workspace_checklist => { root.dismiss_workspace_checklist(); }
                        build_revision_requested(ref_sha) => {
                            root.build_specific_revision_requested(ref_sha);
                            root.active_tab = 2;
                        }
                        verify_pair_requested => { root.verify_pair_requested(); }
                    }

                    if root.active_tab == 2: BuildsView {
                        width: 100%;
                        height: 100%;
                        builds: root.builds;
                        selected_build_idx <=> root.selected_build_idx;
                        selected_build_log: root.selected_build_log;
                        selected_hash: root.selected_hash;
                        selected_artifact_count: root.selected_artifact_count;
                        selected_backend_type <=> root.selected_backend_type;
                        active_target_label: root.active_target_label;
                        docker_available: root.docker_available;
                        active_build_count: root.active_build_count;
                        build_row_clicked(idx) => { root.build_row_clicked(idx); }
                        trigger_build_requested => { root.trigger_build_requested(); }
                        verify_pair_requested => { root.verify_pair_requested(); }
                        compare_latest_requested => { root.compare_latest_requested(); }
                        cancel_build_requested => { root.cancel_build_requested(); }
                        backend_type_selected(b) => { root.backend_type_selected(b); }
                    }

                    if root.active_tab == 3: DiagnosticsView {
                        width: 100%;
                        height: 100%;
                        diag_target_a: root.diag_target_a;
                        diag_target_b: root.diag_target_b;
                        diag_verdict: root.diag_verdict;
                        cri_content: root.cri_content;
                        cri_metadata: root.cri_metadata;
                        cri_environment: root.cri_environment;
                        diff_entries: root.diff_entries;
                        diff_selected_idx <=> root.diff_selected_idx;
                        selected_diff_snippet: root.selected_diff_snippet;
                        diagnostic_findings: root.diagnostic_findings;
                        diff_entry_selected(idx) => { root.diff_entry_selected(idx); }
                        compare_latest_requested => { root.compare_latest_requested(); }
                    }

                    if root.active_tab == 4: CausalityGraphView {
                        width: 100%;
                        height: 100%;
                        nodes: root.graph_nodes;
                        edges: root.graph_edges;
                        selected_node_idx <=> root.selected_graph_node_idx;
                        node_selected(idx) => { root.graph_node_selected(idx); }
                        refresh_graph_requested => { root.refresh_graph_requested(); }
                        export_dot_requested => { root.export_dot_requested(); }
                    }

                    if root.active_tab == 5: PerturbationView {
                        width: 100%;
                        height: 100%;
                        params: root.perturbation_params;
                        results: root.sensitivity_results;
                        is_running: root.perturbation_running;
                        run_campaign_requested => { root.run_perturbation_campaign_requested(); }
                    }

                    if root.active_tab == 6: PassportView {
                        width: 100%;
                        height: 100%;
                        passport_json: root.passport_json;
                        passport_repo: root.passport_repo;
                        passport_status: root.passport_status;
                        export_json_requested => { root.export_passport_json_requested(); }
                        export_md_requested => { root.export_passport_md_requested(); }
                    }

                    if root.active_tab == 7: RemediationView {
                        width: 100%;
                        height: 100%;
                        proposals: root.remediation_proposals;
                        selected_proposal_idx <=> root.selected_proposal_idx;
                        proposal_selected(idx) => { root.remediation_proposal_selected(idx); }
                        approve_patch_requested(id) => { root.approve_patch_requested(id); }
                        run_verification_rebuild_requested => { root.run_verification_rebuild_requested(); }
                    }

                    if root.active_tab == 8: SettingsView {
                        width: 100%;
                        height: 100%;
                        storage_db_path: root.storage_db_path;
                        storage_artifacts_path: root.storage_artifacts_path;
                        storage_workspaces_path: root.storage_workspaces_path;
                        docker_available: root.docker_available;
                        app_version: root.app_version;
                    }
                }
            }
        }
    }

    AboutModal {
        show: root.show_about;
        version: root.app_version;
        close_requested => { root.show_about = false; }
    }
}
